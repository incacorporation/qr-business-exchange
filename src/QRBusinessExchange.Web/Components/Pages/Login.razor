@page "/login"
@using QRBusinessExchange.Core.DTOs
@using QRBusinessExchange.Web.Services
@using QRBusinessExchange.Web.Models
@using Microsoft.JSInterop
@using Microsoft.Extensions.Configuration
@inject ApiService ApiService
@inject IndexedDBService IndexedDB
@inject RenderModeService RenderMode
@inject StateService StateService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@implements IAsyncDisposable

<PageTitle>Login - QR Business Exchange</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4">Login</h3>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    <EditForm Model="loginRequest" OnValidSubmit="HandleLogin">
                        <DataAnnotationsValidator />
                        
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <InputText id="email" @bind-Value="loginRequest.Email" class="form-control" placeholder="Enter your email" />
                            <ValidationMessage For="@(() => loginRequest.Email)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <InputText id="password" type="password" @bind-Value="loginRequest.Password" class="form-control" placeholder="Enter your password" />
                            <ValidationMessage For="@(() => loginRequest.Password)" class="text-danger" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Logging in...</span>
                                }
                                else
                                {
                                    <span>Login</span>
                                }
                            </button>
                        </div>
                    </EditForm>

                    <div class="text-center mt-3">
                        <p class="mb-0">Don't have an account? <a href="/register">Register here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool _disposed = false;
    private bool _isInteractive = false;
    private bool _indexedDBEnabled = false;

    protected override void OnInitialized()
    {
        // Check if IndexedDB is enabled in configuration
        _indexedDBEnabled = Configuration.GetValue<bool>("FeatureFlags:EnableIndexedDB", false);
        Console.WriteLine($"IndexedDB enabled: {_indexedDBEnabled}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed && _indexedDBEnabled)
        {
            try
            {
                _isInteractive = await RenderMode.IsInteractiveAsync();
                Console.WriteLine($"Render mode interactive: {_isInteractive}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking render mode: {ex.Message}");
                _isInteractive = false;
            }
        }
    }

    private async Task HandleLogin()
    {
        Console.WriteLine("=== HandleLogin STARTED ===");
        Console.WriteLine($"Disposed: {_disposed}");

        if (_disposed) return;

        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            Console.WriteLine($"Calling API: api/auth/login with email: {loginRequest.Email}");
            var response = await ApiService.PostAsync("api/auth/login", loginRequest);

            Console.WriteLine($"API Response Status: {response.StatusCode}");
            Console.WriteLine($"API Response Success: {response.IsSuccessStatusCode}");

            if (_disposed)
            {
                Console.WriteLine("Component disposed after API call - returning");
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Parsing response...");
                var result = await ApiService.ParseResponseAsync<AuthResponse>(response);

                Console.WriteLine($"Parse result: {(result != null ? "SUCCESS" : "NULL")}");

                if (_disposed)
                {
                    Console.WriteLine("Component disposed after parsing - returning");
                    return;
                }

                if (result != null && !string.IsNullOrEmpty(result.AccessToken))
                {
                    Console.WriteLine("=== LOGIN SUCCESS ===");
                    Console.WriteLine($"User: {result.User.Email}");
                    Console.WriteLine($"Email Verified: {result.User.IsEmailVerified}");
                    Console.WriteLine($"Token: {result.AccessToken.Substring(0, Math.Min(20, result.AccessToken.Length))}...");

                    // Update state - map UserDto to UserProfileDto
                    Console.WriteLine("Creating UserProfileDto...");
                    StateService.CurrentUser = new UserProfileDto
                    {
                        UserId = result.User.UserId,
                        Email = result.User.Email,
                        FirstName = result.User.FirstName,
                        LastName = result.User.LastName,
                        CompanyName = result.User.CompanyName,
                        PhoneNumber = result.User.PhoneNumber,
                        ProfileImageUrl = result.User.ProfileImageUrl,
                        Bio = result.User.Bio,
                        Skills = result.User.Skills,
                        ServicePricing = result.User.ServicePricing,
                        IsEmailVerified = result.User.IsEmailVerified,
                        Role = result.User.Role,
                        CreatedAt = result.User.CreatedAt
                    };
                    
                    Console.WriteLine($"StateService.CurrentUser set: {StateService.CurrentUser.Email}");
                    
                    // Set authentication flag immediately after user is set
                    StateService.IsAuthenticated = true;
                    Console.WriteLine("StateService.IsAuthenticated set to true");
                    
                    // Subscription will be loaded from API later if needed
                    StateService.CurrentSubscription = null;
                    
                    Console.WriteLine("Notifying auth state changed...");
                    if (AuthStateProvider is CustomAuthStateProvider customProvider)
                    {
                        customProvider.NotifyAuthenticationStateChanged();
                    }

                    // Save to IndexedDB in background (non-blocking)
                    if (_indexedDBEnabled && _isInteractive && !_disposed)
                    {
                        Console.WriteLine("Starting IndexedDB save (background)...");
                        // Fire-and-forget: Save tokens without blocking navigation
                        _ = SaveToIndexedDBAsync(result.AccessToken, result.User.UserId.ToString());
                    }
                    else
                    {
                        Console.WriteLine($"Skipping IndexedDB - Enabled: {_indexedDBEnabled}, Interactive: {_isInteractive}");
                    }
                    
                    // Navigate immediately to dashboard (don't wait for IndexedDB)
                    Console.WriteLine($"Preparing to navigate... (disposed: {_disposed})");
                    
                    if (!_disposed)
                    {
                        if (!result.User.IsEmailVerified)
                        {
                            Console.WriteLine("→ Navigating to: /email-verification");
                            Navigation.NavigateTo("/email-verification");
                        }
                        else
                        {
                            Console.WriteLine("→ Navigating to: /dashboard");
                            try
                            {
                                Navigation.NavigateTo("/dashboard");
                                Console.WriteLine("✓ Navigation.NavigateTo called successfully");
                            }
                            catch (Exception navEx)
                            {
                                Console.WriteLine($"✗ Navigation error: {navEx.Message}");
                                Console.WriteLine($"Stack: {navEx.StackTrace}");
                            }
                        }
                    }
                    else
                    {
                        Console.WriteLine("⚠ Navigation skipped - component disposed");
                    }
                }
                else
                {
                    Console.WriteLine("⚠ Invalid response - result is null or token is empty");
                    errorMessage = "Invalid response from server.";
                }
            }
            else
            {
                Console.WriteLine($"⚠ Login failed - Status: {response.StatusCode}");
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error response: {errorContent}");
                errorMessage = "Invalid email or password.";
            }
        }
        catch (JSDisconnectedException ex)
        {
            Console.WriteLine($"✗ Circuit disconnected during login: {ex.Message}");
            errorMessage = "Connection lost. Please try again.";
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Console.WriteLine($"✗ Login error: {ex.Message}");
                Console.WriteLine($"Stack trace: {ex.StackTrace}");
                errorMessage = $"An error occurred: {ex.Message}";
            }
        }
        finally
        {
            Console.WriteLine("=== HandleLogin COMPLETED ===");
            if (!_disposed)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task SaveToIndexedDBAsync(string token, string userId)
    {
        try
        {
            // Delay to ensure SignalR circuit is fully established
            await Task.Delay(500);
            
            if (!_disposed && _isInteractive && _indexedDBEnabled)
            {
                Console.WriteLine("Saving auth token to IndexedDB...");
                await IndexedDB.SetItemAsync("authToken", token);
                
                if (!_disposed)
                {
                    Console.WriteLine("Saving user ID to IndexedDB...");
                    await IndexedDB.SetItemAsync("userId", userId);
                }
                
                Console.WriteLine("✓ Auth data saved to IndexedDB successfully");
            }
        }
        catch (JSDisconnectedException)
        {
            Console.WriteLine("⚠ Circuit disconnected while saving to IndexedDB (non-critical)");
        }
        catch (TaskCanceledException)
        {
            Console.WriteLine("⚠ IndexedDB save cancelled (non-critical)");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠ IndexedDB save error (non-critical): {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await Task.CompletedTask;
    }
}


