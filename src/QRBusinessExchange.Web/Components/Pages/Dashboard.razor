@page "/dashboard"
@using QRBusinessExchange.Core.DTOs
@using QRBusinessExchange.Web.Services
@using QRBusinessExchange.Web.Models
@using QRBusinessExchange.Web.Components.Dashboard
@using QRBusinessExchange.Web.Components.Map
@inject ApiService ApiService
@inject StateService StateService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Dashboard - QR Business Exchange</PageTitle>

<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading dashboard...</p>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-12">
                <h2>Welcome, @StateService.UserFullName!</h2>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <CreditDisplay Credits="@StateService.CreditsRemaining" />
            </div>
            <div class="col-md-4">
                <SubscriptionBadge SubscriptionType="@StateService.SubscriptionType" />
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Connections</h5>
                        <h2 class="mb-0">@totalConnections</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Usage Overview</h5>
                        <UsageGraph UsageData="@usageData" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Nearby Users</h5>
                        <LeafletMap Users="@nearbyUsers" CurrentUserId="@StateService.CurrentUser?.UserId" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private int totalConnections = 0;
    private List<UsageDataPoint> usageData = new();
    private List<UserLocationDto> nearbyUsers = new();

    protected override async Task OnInitializedAsync()
    {
        if (!StateService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Load analytics - get list of analytics for the last 30 days
            var analyticsList = await ApiService.GetAsync<List<AnalyticsDto>>($"api/analytics/{StateService.CurrentUser?.UserId}");
            if (analyticsList != null && analyticsList.Any())
            {
                totalConnections = analyticsList.Sum(a => a.ConnectionsMade);
                usageData = new List<UsageDataPoint>
                {
                    new UsageDataPoint { Label = "QR Scans", Value = analyticsList.Sum(a => a.QRScans) },
                    new UsageDataPoint { Label = "Profile Views", Value = analyticsList.Sum(a => a.ProfileViews) },
                    new UsageDataPoint { Label = "Connections", Value = totalConnections }
                };
            }

            // Load nearby users
            var users = await ApiService.GetAsync<List<UserLocationDto>>("api/users/nearby");
            if (users != null)
            {
                nearbyUsers = users;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
