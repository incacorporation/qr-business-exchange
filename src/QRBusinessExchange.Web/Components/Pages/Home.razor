@page "/"
@rendermode InteractiveServer

<PageTitle>Home - QR Business Exchange</PageTitle>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 mb-3">Welcome to QR Business Exchange</h1>
        <p class="lead">Connect with professionals through QR codes and location-based networking</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-qr-code display-4 text-primary mb-3"></i>
                    <h5 class="card-title">QR Code Profiles</h5>
                    <p class="card-text">Create and share your professional profile via QR codes</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-geo-alt display-4 text-primary mb-3"></i>
                    <h5 class="card-title">Location-Based</h5>
                    <p class="card-text">Find and connect with professionals nearby</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-people display-4 text-primary mb-3"></i>
                    <h5 class="card-title">Network Growth</h5>
                    <p class="card-text">Build your professional network efficiently</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 text-center">
            <h3 class="mb-4">Get Started Today</h3>
            <div class="d-flex gap-3 justify-content-center">
                <a href="/register" class="btn btn-primary btn-lg">
                    <i class="bi bi-person-plus"></i> Sign Up
                </a>
                <a href="/login" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body">
                    <h4 class="card-title">Features</h4>
                    <ul class="list-unstyled">
                        <li><i class="bi bi-check-circle text-success"></i> Custom QR code generation</li>
                        <li><i class="bi bi-check-circle text-success"></i> Real-time location mapping</li>
                        <li><i class="bi bi-check-circle text-success"></i> Analytics dashboard</li>
                        <li><i class="bi bi-check-circle text-success"></i> Ping Me notifications</li>
                        <li><i class="bi bi-check-circle text-success"></i> Multiple subscription tiers</li>
                        <li><i class="bi bi-check-circle text-success"></i> Secure authentication</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
