@rendermode InteractiveServer

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Subscription</h5>
        <div class="d-flex align-items-center">
            <span class="badge @GetBadgeClass() fs-5 py-2 px-3">
                @SubscriptionType
            </span>
        </div>
        <p class="text-muted mt-2 mb-0">@GetSubscriptionDescription()</p>
        <a href="/subscriptions" class="btn btn-sm btn-outline-primary mt-2">Manage Plan</a>
    </div>
</div>

@code {
    [Parameter]
    public string SubscriptionType { get; set; } = "Free";

    private string GetBadgeClass()
    {
        return SubscriptionType switch
        {
            "Free" => "bg-secondary",
            "Basic" => "bg-info",
            "Premium" => "bg-primary",
            "Enterprise" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetSubscriptionDescription()
    {
        return SubscriptionType switch
        {
            "Free" => "Limited features available",
            "Basic" => "Standard features unlocked",
            "Premium" => "Advanced features available",
            "Enterprise" => "All features + priority support",
            _ => "Unknown plan"
        };
    }
}
