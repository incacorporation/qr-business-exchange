<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QRBusinessExchange.Core\QRBusinessExchange.Core.csproj" />
    <ProjectReference Include="..\QRBusinessExchange.Infrastructure\QRBusinessExchange.Infrastructure.csproj" />
    <ProjectReference Include="..\QRBusinessExchange.Client\QRBusinessExchange.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude Web wwwroot from static files to avoid conflicts with Client -->
    <Compile Remove="Components\Layout\**" />
    <Compile Remove="Components\Pages\**" />
    <Content Remove="Components\Layout\**" />
    <Content Remove="Components\Pages\**" />
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Remove="Components\Layout\**" />
    <EmbeddedResource Remove="Components\Pages\**" />
    <None Remove="Components\Layout\**" />
    <None Remove="Components\Pages\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Services\ApiService.cs" />
    <Compile Remove="Services\StateService.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>


