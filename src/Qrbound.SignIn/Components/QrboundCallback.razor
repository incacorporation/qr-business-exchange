@namespace Qrbound.SignIn
@inject QrboundClient Client
@inject QrboundAuthState AuthState
@inject NavigationManager Navigation

@* Put this on the page at your redirect URI. It finishes a redirect sign-in (the
   "use a passkey on this device" fallback) and returns to where the user started. *@

@if (error != null)
{
    <div class="qrbound-signin">
        <div class="qrbound-alert" role="alert">@error</div>
        <a class="qrbound-button" href="@(FailureUrl ?? Navigation.BaseUri)">Back</a>
    </div>
}
else
{
    <div class="qrbound-signin"><div class="qrbound-center"><span class="qrbound-spinner" role="status" aria-label="Signing in"></span></div></div>
}

@code {
    /// <summary>Raised after sign-in, before navigating away.</summary>
    [Parameter] public EventCallback<QrboundSignInResult> OnSignedIn { get; set; }

    /// <summary>Where to go when there is no (safe) return URL. Defaults to the app's base URL.</summary>
    [Parameter] public string? DefaultReturnUrl { get; set; }

    [Parameter] public string? FailureUrl { get; set; }

    /// <summary>
    /// Load the return URL as a full page instead of navigating inside the Blazor app. Set this when the
    /// component is hosted outside a Blazor router (MVC or Razor Pages views) and the return URL is a
    /// server endpoint, for example one that sets your sign-in cookie. Without it, Blazor only changes
    /// the address bar there and the endpoint never runs.
    /// </summary>
    [Parameter] public bool ForceLoad { get; set; }

    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var result = await Client.HandleCallbackAsync(new Uri(Navigation.Uri));
            AuthState.SignIn(result);
            await OnSignedIn.InvokeAsync(result);
            Navigation.NavigateTo(SafeReturnUrl(result.ReturnUrl), forceLoad: ForceLoad, replace: true);
        }
        catch (QrboundException ex)
        {
            // access_denied is also a refused or revoked category; only a bare cancel gets the generic text.
            // access_pending and access_required carry qrbound's own explanation.
            error = ex.Error == "access_denied" && (ex.Message == ex.Error || ex.Message == "The user cancelled sign-in")
                ? "Sign-in was cancelled."
                : ex.Message;
            StateHasChanged();
        }
        catch (HttpRequestException)
        {
            error = "Could not reach qrbound. Please try again.";
            StateHasChanged();
        }
    }

    // Only same-app URLs: never bounce the user to another site after sign-in.
    private string SafeReturnUrl(string? url)
    {
        var fallback = DefaultReturnUrl ?? Navigation.BaseUri;
        if (string.IsNullOrEmpty(url)) return fallback;
        var absolute = Navigation.ToAbsoluteUri(url).ToString();
        var callback = Navigation.Uri.Split('?')[0];
        return absolute.StartsWith(Navigation.BaseUri, StringComparison.OrdinalIgnoreCase) &&
               !absolute.StartsWith(callback, StringComparison.OrdinalIgnoreCase)
            ? absolute
            : fallback;
    }
}
