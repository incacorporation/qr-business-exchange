@namespace Qrbound.SignIn

@* Same as QrboundSignIn, but the phone is offered "Create a qrbound account" first. *@

<QrboundSignIn Mode="QrboundMode.Register" Title="@Title" CssClass="@CssClass"
               ShowRedirectFallback="@ShowRedirectFallback" ReturnUrl="@ReturnUrl"
               OnSignedIn="OnSignedIn" OnError="OnError" AutoRenewCount="@AutoRenewCount" />

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool ShowRedirectFallback { get; set; } = false;
    [Parameter] public string? ReturnUrl { get; set; }
    [Parameter] public EventCallback<QrboundSignInResult> OnSignedIn { get; set; }
    [Parameter] public EventCallback<QrboundException> OnError { get; set; }
    [Parameter] public int AutoRenewCount { get; set; } = 2;
}
