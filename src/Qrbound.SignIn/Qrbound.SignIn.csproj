<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Qrbound.SignIn</RootNamespace>

    <!-- NuGet package -->
    <IsPackable>true</IsPackable>
    <PackageId>Qrbound.SignIn</PackageId>
    <Version>0.1.0</Version>
    <Authors>QRBound</Authors>
    <Description>Drop-in Blazor components that let users sign in to (or register for) your app with qrbound by scanning a QR code with their phone. Uses the authorization-code flow with PKCE, so no client secret ships in browser code.</Description>
    <PackageTags>qrbound;sso;passkey;qr;blazor;pkce;oauth</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Qrbound.SignIn.Tests" />
  </ItemGroup>

</Project>
