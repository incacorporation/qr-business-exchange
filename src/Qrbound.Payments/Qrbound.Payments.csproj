<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Qrbound.Payments</RootNamespace>

    <!-- NuGet package -->
    <IsPackable>true</IsPackable>
    <PackageId>Qrbound.Payments</PackageId>
    <Version>0.3.1</Version>
    <Authors>QRBound</Authors>
    <Description>Blazor components for qrbound card payments through CardPointe: a complete payment form, CardPointe's hosted card fields, a QR code and a pay-by-QR page, plus a typed client for the qrbound payment endpoints. Cards are tokenized by CardPointe's hosted iFrame, so card numbers never reach your code.</Description>
    <PackageTags>qrbound;payments;qr;blazor;cardpointe</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
