@page "/reset-password"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using QRBusinessExchange.Core.DTOs
@using QRBusinessExchange.Client.Services
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Opened from the emailed link: /reset-password#token=...  The token is in the URL fragment,
   so it is never sent to any server in a request line, log or Referer header. *@

<PageTitle>Choose a new password - qrbound</PageTitle>

<div class="auth-narrow">
    @if (done)
    {
        <div class="text-center">
            <i class="bi bi-check-circle-fill display-4" style="color: #7CF29A;" aria-hidden="true"></i>
            <h1 class="auth-title mt-3">Password changed</h1>
            <p class="auth-subtitle">You can log in with your new password now. We've emailed you a confirmation.</p>
            <a href="/login" class="auth-btn">Log in</a>
        </div>
    }
    else if (string.IsNullOrEmpty(token))
    {
        <div class="text-center">
            <i class="bi bi-link-45deg display-4 text-white" aria-hidden="true"></i>
            <h1 class="auth-title mt-3">This link isn't complete</h1>
            <p class="auth-subtitle">Open the link from the email again, or request a new one.</p>
            <a href="/forgot-password" class="auth-btn">Request a new link</a>
        </div>
    }
    else
    {
        <h1 class="auth-title">Choose a new password</h1>
        <p class="auth-subtitle">Use at least 8 characters. Don't reuse a password from another site.</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger auth-alert" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                @if (linkExpired)
                {
                    <div class="mt-2"><a href="/forgot-password" class="alert-link">Request a new link</a></div>
                }
            </div>
        }

        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            @* Lets password managers save the new password against the right account. *@
            <input type="text" name="username" autocomplete="username" class="d-none" aria-hidden="true" tabindex="-1" />

            <div class="auth-field">
                <label for="newPassword" class="visually-hidden">New password</label>
                <InputText id="newPassword" type="password" class="form-control auth-input" placeholder="New password"
                           @bind-Value="form.Password" autocomplete="new-password" disabled="@working" />
                <ValidationMessage For="() => form.Password" />
            </div>

            <div class="auth-field mb-4">
                <label for="confirmPassword" class="visually-hidden">Confirm new password</label>
                <InputText id="confirmPassword" type="password" class="form-control auth-input" placeholder="Confirm new password"
                           @bind-Value="form.ConfirmPassword" autocomplete="new-password" disabled="@working" />
                <ValidationMessage For="() => form.ConfirmPassword" />
            </div>

            <button type="submit" class="auth-btn" disabled="@working">
                @if (working)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                <span>Save new password</span>
            </button>
        </EditForm>
    }

    <hr class="auth-divider" />

    <nav class="auth-links" aria-label="Account help">
        <a href="/login">Back to log in</a>
    </nav>
</div>

@code {
    private readonly ResetForm form = new();
    private string? token;
    private bool working;
    private bool done;
    private bool linkExpired;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var fragment = uri.Fragment.TrimStart('#');
        foreach (var part in fragment.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && pair[0] == "token")
            {
                token = Uri.UnescapeDataString(pair[1]);
            }
        }
    }

    private async Task SaveAsync()
    {
        working = true;
        errorMessage = null;
        linkExpired = false;
        try
        {
            var response = await ApiService.PostAsync("api/auth/reset-password", new ResetPasswordRequest
            {
                Token = token!,
                NewPassword = form.Password
            });

            if (response.IsSuccessStatusCode)
            {
                done = true;
                form.Password = form.ConfirmPassword = string.Empty;
                token = null;
                // The link is used up; take the token out of the address bar and history.
                await JS.InvokeVoidAsync("history.replaceState", null, "", "/reset-password");
                return;
            }

            errorMessage = await ApiService.ReadErrorAsync(response, "Couldn't change the password. Please try again.");
            linkExpired = response.StatusCode == System.Net.HttpStatusCode.BadRequest;
        }
        catch (Exception)
        {
            errorMessage = "Network error. Check your connection and try again.";
        }
        finally
        {
            working = false;
        }
    }

    private sealed class ResetForm
    {
        [Required(ErrorMessage = "Enter a new password")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Use at least 8 characters")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your new password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords don't match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
