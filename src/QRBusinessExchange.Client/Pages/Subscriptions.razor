@page "/subscriptions"
@using QRBusinessExchange.Core.DTOs
@using QRBusinessExchange.Client.Services
@inject ApiService ApiService
@inject StateService StateService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PortalAuthService PortalAuth
@using QRBusinessExchange.Client.Pages

<PageTitle>Subscriptions - qrbound</PageTitle>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Subscription Plans</h2>
            <p class="text-muted">Choose the plan that fits your needs</p>
            @if (!StateService.IsAuthenticated)
            {
                <p class="mb-0">Already have an account? <a href="/login?returnUrl=%2Fsubscriptions">Log in</a> to change your plan.</p>
            }
            else
            {
                <p class="mb-0">Paid plans can't be bought online yet: choose <strong>Contact us</strong> on a plan and we'll set it up.</p>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info">@message</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow h-100 @(IsCurrent("Free") ? "border-primary" : "")">
                <div class="card-body d-flex flex-column">
                    <h4 class="card-title">Free</h4>
                    <h2 class="mb-3">$0<small class="text-muted">/month</small></h2>
                    <ul class="list-unstyled mb-4 flex-grow-1">
                        <li><i class="bi bi-check text-success"></i> 10 credits/month</li>
                        <li><i class="bi bi-check text-success"></i> Basic QR code</li>
                        <li><i class="bi bi-check text-success"></i> Limited map access</li>
                        <li><i class="bi bi-check text-success"></i> Email support</li>
                    </ul>
                    @if (!StateService.IsAuthenticated)
                    {
                        <a class="btn btn-outline-primary" href="@SignUpHref">Get started</a>
                    }
                    else if (IsCurrent("Free"))
                    {
                        <button class="btn btn-outline-primary" disabled>Current Plan</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary" disabled="@busy" @onclick="SwitchToFreeAsync">Switch to Free</button>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow h-100 @(IsCurrent("Basic") ? "border-primary" : "")">
                <div class="card-body d-flex flex-column">
                    <h4 class="card-title">Basic</h4>
                    <h2 class="mb-3">$9.99<small class="text-muted">/month</small></h2>
                    <ul class="list-unstyled mb-4 flex-grow-1">
                        <li><i class="bi bi-check text-success"></i> 50 credits/month</li>
                        <li><i class="bi bi-check text-success"></i> Custom QR code</li>
                        <li><i class="bi bi-check text-success"></i> Full map access</li>
                        <li><i class="bi bi-check text-success"></i> Priority email support</li>
                        <li><i class="bi bi-check text-success"></i> Analytics dashboard</li>
                    </ul>
                    @if (!StateService.IsAuthenticated)
                    {
                        <a class="btn btn-primary" href="@SignUpHref">Get started</a>
                    }
                    else if (IsCurrent("Basic"))
                    {
                        <button class="btn btn-primary" disabled>Current Plan</button>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary" href="@ContactHref("Basic")">Contact us</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow h-100 @(IsCurrent("Premium") ? "border-primary" : "")">
                <div class="card-body d-flex flex-column">
                    <h4 class="card-title">Premium</h4>
                    <h2 class="mb-3">$29.99<small class="text-muted">/month</small></h2>
                    <ul class="list-unstyled mb-4 flex-grow-1">
                        <li><i class="bi bi-check text-success"></i> 200 credits/month</li>
                        <li><i class="bi bi-check text-success"></i> All Basic features</li>
                        <li><i class="bi bi-check text-success"></i> Advanced analytics</li>
                        <li><i class="bi bi-check text-success"></i> Ping Me feature</li>
                        <li><i class="bi bi-check text-success"></i> No ads</li>
                    </ul>
                    @if (!StateService.IsAuthenticated)
                    {
                        <a class="btn btn-primary" href="@SignUpHref">Get started</a>
                    }
                    else if (IsCurrent("Premium"))
                    {
                        <button class="btn btn-primary" disabled>Current Plan</button>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary" href="@ContactHref("Premium")">Contact us</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow h-100 @(IsCurrent("Enterprise") ? "border-primary" : "")">
                <div class="card-body d-flex flex-column">
                    <h4 class="card-title">Enterprise</h4>
                    <h2 class="mb-3">$99.99<small class="text-muted">/month</small></h2>
                    <ul class="list-unstyled mb-4 flex-grow-1">
                        <li><i class="bi bi-check text-success"></i> 1,000 credits/month</li>
                        <li><i class="bi bi-check text-success"></i> All Premium features</li>
                        <li><i class="bi bi-check text-success"></i> API access</li>
                        <li><i class="bi bi-check text-success"></i> Custom integrations</li>
                        <li><i class="bi bi-check text-success"></i> Dedicated support</li>
                    </ul>
                    @if (!StateService.IsAuthenticated)
                    {
                        <a class="btn btn-primary" href="@SignUpHref">Get started</a>
                    }
                    else if (IsCurrent("Enterprise"))
                    {
                        <button class="btn btn-primary" disabled>Current Plan</button>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary" href="@ContactHref("Enterprise")">Contact us</a>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (StateService.CurrentSubscription != null)
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">Current Subscription Details</h5>
                        <p><strong>Plan:</strong> @StateService.SubscriptionType</p>
                        <p><strong>Credits Available:</strong> @StateService.CreditsRemaining</p>
                        <p><strong>Credits Used:</strong> @StateService.CurrentSubscription.CreditsUsed</p>
                        @if (StateService.CurrentSubscription.EndDate.HasValue)
                        {
                            <p><strong>Renewal Date:</strong> @StateService.CurrentSubscription.EndDate.Value.ToString("MMM dd, yyyy")</p>
                        }
                        <p><strong>Auto Renew:</strong> @(StateService.CurrentSubscription.AutoRenew ? "Yes" : "No")</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string message = string.Empty;

    // Anyone can compare plans; signing up (or in) is only needed to choose one.
    private const string SignUpHref = "/register?returnUrl=%2Fsubscriptions";

    private bool IsCurrent(string planType) => StateService.IsAuthenticated && StateService.SubscriptionType == planType;

    private bool busy;

    // Show the plan as it is on the server now (it may have been changed by qrbound staff).
    protected override async Task OnInitializedAsync()
    {
        if (StateService.IsAuthenticated)
        {
            await PortalAuth.RefreshSubscriptionAsync();
        }
    }

    // There is no online checkout yet: paid plans are set up by email.
    private static string ContactHref(string planType) =>
        $"mailto:{LegalInfo.ContactEmail}?subject={Uri.EscapeDataString($"qrbound {planType} plan")}";

    private async Task SwitchToFreeAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Switch from {StateService.SubscriptionType} to the Free plan? Your current plan and its remaining credits end now."))
        {
            return;
        }

        busy = true;
        message = "Switching to the Free plan...";
        try
        {
            var response = await ApiService.PostAsync("api/subscription/downgrade", new { });
            if (response.IsSuccessStatusCode)
            {
                StateService.CurrentSubscription = null; // no active subscription = Free
                message = "You're on the Free plan now.";
            }
            else
            {
                message = await ApiService.ReadErrorAsync(response, "Couldn't switch plans. Please try again or contact us.");
            }
        }
        catch (Exception ex)
        {
            message = $"Couldn't reach qrbound: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
