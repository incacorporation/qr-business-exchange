@page "/settings"
@using QRBusinessExchange.Client.Services
@using QRBusinessExchange.Client.Components.Tools
@using QRBusinessExchange.Client.Components.Auth
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject StateService StateService
@inject PingMeService PingMe

<PageTitle>Settings - qrbound</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Settings</h2>
        </div>
    </div>

    @if (!StateService.IsAuthenticated)
    {
        Navigation.NavigateTo("/login");
    }
    else
    {
        <div class="row g-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">Ping Me Feature</h5>
                        <p class="text-muted">Allow others to ping you when nearby</p>
                        <PingMeToggle @key="pingMeVersion" IsEnabled="@StateService.IsPingMeEnabled" Disabled="@pingMeBusy" OnToggle="HandlePingMeToggle" />
                        <small class="text-muted d-block mt-2">
                            When on, your location is shared so people nearby can find you on their map. Turn it off to hide.
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">Account Settings</h5>
                        <div class="list-group list-group-flush">
                            <a href="/profile" class="list-group-item list-group-item-action">
                                <i class="bi bi-person"></i> Edit Profile
                            </a>
                            <a href="/subscriptions" class="list-group-item list-group-item-action">
                                <i class="bi bi-credit-card"></i> Manage Subscription
                            </a>
                            <button class="list-group-item list-group-item-action text-danger" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Passkey Management Section -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <PasskeyManagement @ref="passkeyManagement" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Link a phone: register a passkey on a phone by scanning a QR code -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-phone me-2"></i>Sign in with your phone camera</h5>
                        <LinkPhonePanel OnLinked="OnPhoneLinkedAsync" />
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="row mt-3">
                <div class="col-12">
                    <div class="alert alert-info">@message</div>
                </div>
            </div>
        }
    }
</div>

@code {
    private string message = string.Empty;
    private PasskeyManagement? passkeyManagement;
    private bool pingMeBusy;
    private int pingMeVersion;

    protected override Task OnInitializedAsync() => PingMe.LoadAsync();

    /// <summary>Refresh the passkey list so the newly linked phone shows up.</summary>
    private Task OnPhoneLinkedAsync() => passkeyManagement?.ReloadAsync() ?? Task.CompletedTask;

    private async Task HandlePingMeToggle(bool isEnabled)
    {
        pingMeBusy = true;
        message = string.Empty;
        StateHasChanged();

        var result = await PingMe.SetAsync(isEnabled);
        message = result.Error ?? (result.Enabled
            ? "Ping Me is on. People nearby can find you on their map."
            : "Ping Me is off. You no longer appear on nearby maps.");

        pingMeBusy = false;
        pingMeVersion++; // redraw the switch so it matches the saved setting, even after a failure
        StateHasChanged();
        await Task.Delay(4000);
        message = string.Empty;
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        await StateService.ResetAsync();
        Navigation.NavigateTo("/login");
    }
}
