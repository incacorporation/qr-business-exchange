@page "/forgot-password"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using QRBusinessExchange.Core.DTOs
@using QRBusinessExchange.Client.Services
@inject ApiService ApiService

<PageTitle>Forgot your password? - qrbound</PageTitle>

<div class="auth-narrow">
    @if (sentTo == null)
    {
        <h1 class="auth-title">Forgot your password?</h1>
        <p class="auth-subtitle">Enter your email and we'll send you a link to choose a new one.</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger auth-alert" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            </div>
        }

        <EditForm Model="form" OnValidSubmit="SendAsync">
            <DataAnnotationsValidator />

            <div class="auth-field mb-4">
                <label for="email" class="visually-hidden">Email</label>
                <InputText id="email" type="email" class="form-control auth-input" placeholder="Email"
                           @bind-Value="form.Email" autocomplete="email" disabled="@working" />
                <ValidationMessage For="() => form.Email" />
            </div>

            <button type="submit" class="auth-btn" disabled="@working">
                @if (working)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                <span>Send reset link</span>
            </button>
        </EditForm>
    }
    else
    {
        <div class="text-center">
            <i class="bi bi-envelope-check display-4 text-white" aria-hidden="true"></i>
            <h1 class="auth-title mt-3">Check your email</h1>
            <p class="auth-subtitle mb-2">
                If an account exists for <strong class="text-white">@sentTo</strong>, we've sent it a link to reset the password.
            </p>
            <p class="auth-subtitle small">
                The link works once and expires in 30 minutes. Nothing there? Check your spam folder, or try again in a couple of minutes.
            </p>
            <a href="/login" class="auth-btn">Back to log in</a>
        </div>
    }

    <hr class="auth-divider" />

    <nav class="auth-links" aria-label="Account help">
        @if (sentTo != null)
        {
            <button type="button" class="auth-link-btn" @onclick="StartOver">Use a different email</button>
        }
        <a href="/login">Log in with a passkey instead</a>
        <a href="/register">Register as a new user</a>
    </nav>
</div>

@code {
    private readonly ForgotForm form = new();
    private bool working;
    private string? errorMessage;
    private string? sentTo;

    private async Task SendAsync()
    {
        working = true;
        errorMessage = null;
        try
        {
            var email = form.Email.Trim();
            var response = await ApiService.PostAsync("api/auth/forgot-password", new ForgotPasswordRequest { Email = email });
            if (response.IsSuccessStatusCode)
            {
                sentTo = email;
            }
            else
            {
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                    ? "Too many requests. Please wait a minute and try again."
                    : await ApiService.ReadErrorAsync(response, "Couldn't send the link. Please try again.");
            }
        }
        catch (Exception)
        {
            errorMessage = "Network error. Check your connection and try again.";
        }
        finally
        {
            working = false;
        }
    }

    private void StartOver()
    {
        sentTo = null;
        form.Email = string.Empty;
    }

    private sealed class ForgotForm
    {
        [Required(ErrorMessage = "Enter your email")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        [StringLength(255)]
        public string Email { get; set; } = string.Empty;
    }
}
