@page "/qr/link/{SessionId:guid}"
@layout AuthLayout
@using QRBusinessExchange.Client.Services
@using QRBusinessExchange.Core.DTOs
@inject ApiService ApiService
@inject PortalAuthService PortalAuth
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Phone side of "Link a phone": opened by scanning the QR code shown in Settings on a signed-in computer. *@

<PageTitle>Link this phone</PageTitle>

<div class="auth-medium">
            <div class="card shadow border-0">
                <div class="card-body p-4 text-center">
                    @if (stage == Stage.Loading)
                    {
                        <div class="py-5"><span class="spinner-border text-primary"></span></div>
                    }
                    else if (stage == Stage.Failed)
                    {
                        <i class="bi bi-x-octagon-fill display-4 text-danger"></i>
                        <h4 class="mt-3">Can't link this phone</h4>
                        <p class="text-muted mb-0">@error</p>
                    }
                    else if (stage == Stage.WaitingForComputer)
                    {
                        <i class="bi bi-pc-display display-5 text-primary"></i>
                        <h4 class="mt-3 mb-1">Link this phone</h4>
                        <p class="text-muted small">to <strong>@claim?.AccountHint</strong></p>

                        <p class="fw-semibold mb-1">On your computer, pick this number</p>
                        <div class="link-code display-3 fw-bold my-3" aria-label="Verification number">@claim?.VerificationCode</div>
                        <p class="text-muted small mb-4">
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            Waiting for your computer… (@SecondsLeft s)
                        </p>

                        <button class="btn btn-outline-danger btn-sm" @onclick="CancelAsync">Cancel</button>
                    }
                    else if (stage == Stage.ReadyToCreate)
                    {
                        <i class="bi bi-fingerprint display-4 text-success"></i>
                        <h4 class="mt-3 mb-1">Create a passkey on this phone</h4>
                        <p class="text-muted small mb-3">
                            For <strong>@claim?.AccountHint</strong>. Your phone will ask for your fingerprint, face or screen lock.
                        </p>

                        <div class="text-start mb-3">
                            <label class="form-label small text-muted" for="deviceName">Name for this phone</label>
                            <input id="deviceName" class="form-control" maxlength="100" @bind="deviceName" disabled="@working" />
                        </div>

                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="alert alert-danger small">@error</div>
                        }

                        <div class="d-grid gap-2">
                            <button class="btn btn-success btn-lg" @onclick="CreatePasskeyAsync" disabled="@working">
                                @if (working)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Create passkey
                            </button>
                            <button class="btn btn-link btn-sm text-danger" @onclick="CancelAsync" disabled="@working">Cancel</button>
                        </div>
                        <p class="text-muted small mt-3 mb-0">Expires in @SecondsLeft s</p>
                    }
                    else if (stage == Stage.Done)
                    {
                        <i class="bi bi-check-circle-fill display-3 text-success"></i>
                        <h4 class="mt-3">This phone is linked</h4>
                        <p class="text-muted">
                            You're signed in. From now on, scan "Sign in with your phone" QR codes with this
                            phone's camera to approve sign-ins on other computers.
                        </p>
                        <a class="btn btn-primary" href="/dashboard">Continue</a>
                    }
                </div>
            </div>
</div>

@code {
    private enum Stage { Loading, Failed, WaitingForComputer, ReadyToCreate, Done }

    [Parameter] public Guid SessionId { get; set; }

    private Stage stage = Stage.Loading;
    private DeviceLinkClaimResponse? claim;
    private string? error;
    private string? deviceName;
    private bool working;
    private DateTime expiresAt;
    private CancellationTokenSource? cts;

    private int SecondsLeft => Math.Max(0, (int)(expiresAt - DateTime.UtcNow).TotalSeconds);

    protected override async Task OnInitializedAsync()
    {
        var linkSecret = ReadSecretFromFragment(Navigation.Uri);
        if (string.IsNullOrEmpty(linkSecret))
        {
            Fail("This link is incomplete. Scan the QR code on your computer again.");
            return;
        }

        try
        {
            var response = await ApiService.PostAsync($"api/device-link/sessions/{SessionId}/claim",
                new DeviceLinkClaimRequest { LinkSecret = linkSecret });

            if (!response.IsSuccessStatusCode)
            {
                Fail(await ApiService.ReadErrorAsync(response, "This QR code is not valid."));
                return;
            }

            claim = await ApiService.ParseResponseAsync<DeviceLinkClaimResponse>(response);
            if (claim == null)
            {
                Fail("This QR code is not valid.");
                return;
            }

            // Claimed: the one-time secret is spent, so drop it from the address bar and history.
            // (Kept until now so a reload can retry if the first attempt hit a network error.)
            try
            {
                await JS.InvokeVoidAsync("history.replaceState", null, "", $"/qr/link/{SessionId}");
            }
            catch
            {
                // not critical
            }

            expiresAt = DateTime.SpecifyKind(claim.ExpiresAt, DateTimeKind.Utc);
            deviceName = DeviceDescriber.DefaultDeviceName(await JS.InvokeAsync<string>("webAuthnInterop.getUserAgent"));
            stage = Stage.WaitingForComputer;

            cts = new CancellationTokenSource();
            _ = PollLoopAsync(cts.Token);
        }
        catch (Exception ex)
        {
            Fail($"Could not reach the server: {ex.Message}");
        }
    }

    private static string? ReadSecretFromFragment(string uri)
    {
        var hash = uri.IndexOf('#');
        if (hash < 0) return null;

        foreach (var part in uri[(hash + 1)..].Split('&'))
        {
            if (part.StartsWith("k=", StringComparison.Ordinal))
            {
                return Uri.UnescapeDataString(part[2..]);
            }
        }

        return null;
    }

    private async Task PollLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Math.Max(1, claim!.PollIntervalSeconds)));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                var response = await ApiService.PostAsync($"api/device-link/sessions/{SessionId}/status",
                    new DeviceLinkPhoneRequest { PhoneSecret = claim.PhoneSecret });
                if (token.IsCancellationRequested) return;

                if (!response.IsSuccessStatusCode)
                {
                    Fail("This link is no longer valid.");
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                var dto = await ApiService.ParseResponseAsync<DeviceLinkPhoneStatusDto>(response);
                if (dto == null) continue;
                expiresAt = DateTime.SpecifyKind(dto.ExpiresAt, DateTimeKind.Utc);

                switch (dto.Status)
                {
                    case DeviceLinkStatus.Confirmed when stage == Stage.WaitingForComputer:
                        stage = Stage.ReadyToCreate; // needs a tap: browsers only show the passkey prompt after a user gesture
                        break;
                    case DeviceLinkStatus.Denied:
                        Fail("Linking was cancelled, or the wrong number was picked on the computer.");
                        await InvokeAsync(StateHasChanged);
                        return;
                    case DeviceLinkStatus.Expired:
                        Fail("The QR code expired. Show a new one on your computer.");
                        await InvokeAsync(StateHasChanged);
                        return;
                    case DeviceLinkStatus.Completed:
                        return;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Fail($"Lost connection to the server: {ex.Message}");
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreatePasskeyAsync()
    {
        if (claim == null) return;

        working = true;
        error = null;
        StateHasChanged();

        try
        {
            var initResponse = await ApiService.PostAsync($"api/device-link/sessions/{SessionId}/register/init",
                new DeviceLinkRegisterInitRequest { PhoneSecret = claim.PhoneSecret, DeviceName = deviceName });
            if (!initResponse.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ApiService.ReadErrorAsync(initResponse, "Could not start creating the passkey."));
            }

            var options = await ApiService.ParseResponseAsync<PasskeyRegistrationOptionsDto>(initResponse)
                ?? throw new InvalidOperationException("Invalid passkey options.");

            var credential = await PortalAuth.CreatePasskeyAsync(options);

            var completeResponse = await ApiService.PostAsync($"api/device-link/sessions/{SessionId}/register/complete",
                new DeviceLinkRegisterCompleteRequest
                {
                    PhoneSecret = claim.PhoneSecret,
                    Challenge = options.Challenge,
                    Credential = credential,
                    DeviceName = deviceName
                });

            if (!completeResponse.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ApiService.ReadErrorAsync(completeResponse, "The passkey could not be saved."));
            }

            var auth = await ApiService.ParseResponseAsync<AuthResponse>(completeResponse)
                ?? throw new InvalidOperationException("Invalid response.");

            cts?.Cancel();
            await PortalAuth.SaveSessionAsync(auth);
            stage = Stage.Done;
        }
        catch (Exception ex)
        {
            error = PortalAuthService.Describe(ex);
        }
        finally
        {
            working = false;
        }
    }

    private async Task CancelAsync()
    {
        cts?.Cancel();
        if (claim != null)
        {
            try
            {
                await ApiService.PostAsync($"api/device-link/sessions/{SessionId}/phone-cancel",
                    new DeviceLinkPhoneRequest { PhoneSecret = claim.PhoneSecret });
            }
            catch
            {
                // best effort
            }
        }

        Fail("Linking was cancelled. Nothing was added to the account.");
    }

    private void Fail(string message)
    {
        error = message;
        stage = Stage.Failed;
    }

    public ValueTask DisposeAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        return ValueTask.CompletedTask;
    }
}

<style>
    .link-code {
        letter-spacing: .15em;
        font-variant-numeric: tabular-nums;
    }
</style>
