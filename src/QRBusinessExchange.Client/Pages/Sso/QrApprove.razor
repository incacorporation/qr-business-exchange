@page "/qr/approve/{SessionId:guid}"
@layout AuthLayout
@using QRBusinessExchange.Client.Services
@using QRBusinessExchange.Client.Components.Auth
@using QRBusinessExchange.Core.DTOs
@inject ApiService ApiService
@inject PortalAuthService PortalAuth
@inject StateService StateService
@inject NavigationManager Navigation

@* Phone side of QR login: opened by scanning the QR code shown on another screen. *@

<PageTitle>Approve sign-in</PageTitle>

<div class="auth-medium">
            <div class="card shadow border-0">
                <div class="card-body p-4">
                    @if (loading)
                    {
                        <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
                    }
                    else if (!signedIn)
                    {
                        @if (Register)
                        {
                            @* Opened from a "Create your account with qrbound" QR code on another site. *@
                            <div class="text-center mb-4">
                                <i class="bi bi-person-plus display-4 text-primary"></i>
                                <h4 class="mt-3">New to qrbound?</h4>
                                <p class="text-muted">Create your free account on this phone. You'll come straight back here to finish signing in on the other screen.</p>
                                <div class="d-grid">
                                    <a class="btn btn-primary btn-lg" href="@($"/register?returnUrl={Uri.EscapeDataString($"/qr/approve/{SessionId}")}")">
                                        <i class="bi bi-person-plus me-2"></i>Create a qrbound account
                                    </a>
                                </div>
                            </div>
                            <hr />
                            <p class="text-center text-muted small">Already have an account?</p>
                        }
                        <div class="text-center">
                            <i class="bi bi-phone display-4 text-primary @(Register ? "d-none" : null)"></i>
                            <h4 class="mt-3 @(Register ? "d-none" : null)">Sign in on this phone first</h4>
                            <p class="text-muted">To approve a sign-in on another screen, this phone must be signed in with a passkey.</p>
                            <p class="text-muted small">
                                No passkey on this phone yet? On a computer where you're signed in, open
                                <strong>Register device</strong> in the menu and scan that QR code with this phone.
                            </p>
                            @if (!string.IsNullOrEmpty(error))
                            {
                                <div class="alert alert-danger small">@error</div>
                            }
                            <div class="d-grid gap-2">
                                <button class="btn btn-primary btn-lg" @onclick="SignInHereAsync" disabled="@working">
                                    <i class="bi bi-key me-2"></i>Sign in with a passkey
                                </button>
                                <a class="btn btn-outline-secondary" href="@($"/login?returnUrl={Uri.EscapeDataString($"/qr/approve/{SessionId}")}")">Other sign-in options</a>
                            </div>
                        </div>
                    }
                    else if (done != null)
                    {
                        <div class="text-center">
                            @if (done == "Approved")
                            {
                                <i class="bi bi-check-circle-fill display-3 text-success"></i>
                                @if (info?.CategoryAccess?.Status == "Pending")
                                {
                                    <h4 class="mt-3">Request sent</h4>
                                    <p class="text-muted mb-0">
                                        @info.CategoryAccess.ApplicationName will review your request to sign in as @info.CategoryAccess.CategoryName.
                                        We'll email you when it's approved; then sign in again on the other screen.
                                    </p>
                                }
                                else
                                {
                                    <h4 class="mt-3">Signed in</h4>
                                    <p class="text-muted mb-0">You can return to the other screen.</p>
                                }
                            }
                            else
                            {
                                <i class="bi bi-x-octagon-fill display-3 text-danger"></i>
                                <h4 class="mt-3">Sign-in blocked</h4>
                                <p class="text-muted mb-0">@(error ?? "The request was declined. Nobody was signed in.")</p>
                            }
                        </div>
                    }
                    else if (connectionLost)
                    {
                        <div class="text-center">
                            <i class="bi bi-wifi-off display-4 text-muted"></i>
                            <h4 class="mt-3">No connection</h4>
                            <p class="text-muted">@error</p>
                            <button class="btn btn-primary btn-lg w-100" @onclick="RetryAsync" disabled="@working">
                                @if (working)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-arrow-repeat me-2"></i>Try again
                            </button>
                        </div>
                    }
                    else if (info == null || info.Status is not ("Pending" or "Scanned"))
                    {
                        <div class="text-center">
                            <i class="bi bi-hourglass-bottom display-4 text-muted"></i>
                            <h4 class="mt-3">This QR code can't be used</h4>
                            <p class="text-muted mb-0">@(error ?? $"The request is {info?.Status?.ToLowerInvariant() ?? "unavailable"}. Refresh the QR code on the other screen and scan again.")</p>
                        </div>
                    }
                    else
                    {
                        <h4 class="fw-bold text-center mb-1">Sign in on another device?</h4>
                        <p class="text-center text-muted">
                            as <strong>@StateService.CurrentUser?.Email</strong>
                        </p>

                        <ul class="list-group list-group-flush small mb-4">
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Signing in to</span>
                                <span class="fw-semibold text-end">@(info.ApplicationName ?? "qrbound")@(info.BusinessName != null ? $" ({info.BusinessName})" : "")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Device</span>
                                <span class="text-end">@DeviceDescriber.Describe(info.RequesterUserAgent)</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">IP address</span>
                                <span>@(info.RequesterIp ?? "unknown")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Requested</span>
                                <span>@DateTime.SpecifyKind(info.CreatedAt, DateTimeKind.Utc).ToLocalTime().ToString("t")</span>
                            </li>
                        </ul>

                        @if (info.CategoryAccess != null)
                        {
                            <CategoryAccessRequest Access="info.CategoryAccess" @bind-BusinessId="requestBusinessId"
                                                   @bind-Note="requestNote" Disabled="@working" />
                        }

                        <p class="fw-semibold text-center mb-2">Tap the number shown on the other screen</p>
                        <div class="d-flex justify-content-center gap-3 mb-3">
                            @foreach (var choice in info.VerificationChoices)
                            {
                                <button class="btn btn-lg @(selected == choice ? "btn-primary" : "btn-outline-primary") number-choice"
                                        @onclick="() => selected = choice" disabled="@working">
                                    @choice
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="alert alert-danger small">@error</div>
                        }

                        <div class="d-grid gap-2">
                            <button class="btn btn-success btn-lg" @onclick="ApproveAsync" disabled="@(selected == null || working || !CanSubmitRequest)">
                                @if (working)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-fingerprint me-2"></i>@(CategoryAccessRequest.NeedsRequest(info.CategoryAccess) ? "Request access and approve" : "Approve with passkey")
                            </button>
                            <button class="btn btn-outline-danger" @onclick="DenyAsync" disabled="@working">
                                This wasn't me
                            </button>
                        </div>

                        <p class="small text-muted mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Only approve if you started this sign-in yourself. Never scan QR codes sent to you by someone else.
                        </p>
                    }
                </div>
            </div>
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    /// <summary>Set by QR codes from Qrbound.SignIn's QrboundRegister: offer account creation first.</summary>
    [SupplyParameterFromQuery(Name = "register")] public string? RegisterParam { get; set; }

    private bool Register => RegisterParam is "1" || string.Equals(RegisterParam, "true", StringComparison.OrdinalIgnoreCase);

    private bool loading = true;
    private bool signedIn;
    private bool working;
    private QrLoginSessionInfoDto? info;
    private string? selected;
    private string? error;
    private string? done;
    private bool connectionLost;
    private Guid? requestBusinessId;
    private string? requestNote;

    private bool CanSubmitRequest =>
        !CategoryAccessRequest.NeedsRequest(info?.CategoryAccess) ||
        CategoryAccessRequest.CanRequest(info!.CategoryAccess!, requestBusinessId);

    protected override async Task OnInitializedAsync()
    {
        signedIn = await PortalAuth.HasSessionAsync();
        if (signedIn)
        {
            await LoadAsync();
        }
        loading = false;
    }

    private async Task LoadAsync()
    {
        error = null;
        connectionLost = false;

        HttpResponseMessage response;
        try
        {
            response = await ApiService.GetResponseAsync($"api/qr-login/sessions/{SessionId}");
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            // Offline or server down: say so and offer a retry instead of crashing the app.
            connectionLost = true;
            error = PortalAuthService.ConnectionProblem;
            return;
        }

        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await PortalAuth.SignOutAsync();
            signedIn = false;
            error = "Your session on this phone has expired.";
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            error = await ApiService.ReadErrorAsync(response, "Sign-in request not found.");
            return;
        }

        info = await ApiService.ParseResponseAsync<QrLoginSessionInfoDto>(response);
    }

    private async Task SignInHereAsync()
    {
        working = true;
        error = null;
        try
        {
            await PortalAuth.SignInWithPasskeyAsync();
            signedIn = true;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = PortalAuthService.Describe(ex);
        }
        finally
        {
            working = false;
        }
    }

    private async Task ApproveAsync()
    {
        if (selected == null) return;

        working = true;
        error = null;
        StateHasChanged();

        try
        {
            // Signing in to an app as a category the user doesn't hold yet ("business"): ask for it first,
            // so the other screen can say the request is waiting for approval.
            if (CategoryAccessRequest.NeedsRequest(info?.CategoryAccess))
            {
                var access = info!.CategoryAccess!;
                var requestResponse = await ApiService.PostAsync("api/sso/access-requests", new SsoAccessRequest
                {
                    ClientId = access.ClientId,
                    Category = access.CategoryKey,
                    BusinessId = access.RequiresBusiness ? requestBusinessId : null,
                    Note = requestNote
                });
                if (!requestResponse.IsSuccessStatusCode)
                {
                    throw new InvalidOperationException(await ApiService.ReadErrorAsync(requestResponse, "Could not send your request."));
                }

                info.CategoryAccess = await ApiService.ParseResponseAsync<SsoCategoryAccessDto>(requestResponse) ?? access;
            }

            var initResponse = await ApiService.PostAsync($"api/qr-login/sessions/{SessionId}/approve/init", new { });
            if (!initResponse.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ApiService.ReadErrorAsync(initResponse, "Could not start passkey confirmation."));
            }

            var options = await ApiService.ParseResponseAsync<PasskeyAuthenticationOptionsDto>(initResponse)
                ?? throw new InvalidOperationException("Invalid passkey options.");

            var assertion = await PortalAuth.AssertAsync(options);

            var response = await ApiService.PostAsync($"api/qr-login/sessions/{SessionId}/approve", new QrLoginApproveRequest
            {
                VerificationCode = selected,
                Challenge = options.Challenge,
                Assertion = assertion
            });

            if (response.IsSuccessStatusCode)
            {
                done = "Approved";
                return;
            }

            var body = await ApiService.ParseResponseAsync<SsoErrorResponse>(response);
            if (body?.Error == "verification_mismatch")
            {
                done = "Denied";
                error = body.ErrorDescription;
                return;
            }

            error = body?.ErrorDescription ?? "Approval failed.";
        }
        catch (Exception ex)
        {
            error = PortalAuthService.Describe(ex);
        }
        finally
        {
            working = false;
        }
    }

    private async Task RetryAsync()
    {
        working = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            working = false;
        }
    }

    private async Task DenyAsync()
    {
        working = true;
        error = null;
        StateHasChanged();

        try
        {
            // Only report "blocked" once the server confirms it; otherwise the sign-in may still be pending.
            var response = await ApiService.PostAsync($"api/qr-login/sessions/{SessionId}/deny", new { });
            if (response.IsSuccessStatusCode)
            {
                done = "Denied";
            }
            else
            {
                error = await ApiService.ReadErrorAsync(response,
                    "The sign-in couldn't be blocked. Tap \"This wasn't me\" again.");
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            error = "Can't reach qrbound, so the sign-in wasn't blocked yet. Check your connection and tap \"This wasn't me\" again.";
        }
        finally
        {
            working = false;
        }
    }
}

<style>
    .number-choice {
        min-width: 4.5rem;
        font-size: 1.5rem;
        font-variant-numeric: tabular-nums;
    }
</style>
