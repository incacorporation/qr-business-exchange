@page "/sso/logout"
@using QRBusinessExchange.Client.Services
@inject ApiService ApiService
@inject PortalAuthService PortalAuth
@inject NavigationManager Navigation

@* Ends the portal session. If client_id + post_logout_redirect_uri are supplied and the URI
   is registered for that application, the browser is sent back there. *@

<PageTitle>Signed out</PageTitle>

<div class="container py-5 text-center">
    @if (redirecting)
    {
        <span class="spinner-border text-primary"></span>
        <p class="text-muted mt-3">Signing you out…</p>
    }
    else
    {
        <i class="bi bi-door-closed display-4 text-primary"></i>
        <h4 class="mt-3">You are signed out</h4>
        <a href="/login" class="btn btn-outline-primary mt-2">Sign in again</a>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "client_id")] public string? ClientId { get; set; }
    [SupplyParameterFromQuery(Name = "post_logout_redirect_uri")] public string? PostLogoutRedirectUri { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }

    private bool redirecting = true;

    protected override async Task OnInitializedAsync()
    {
        await PortalAuth.SignOutAsync();

        if (!string.IsNullOrEmpty(ClientId) && !string.IsNullOrEmpty(PostLogoutRedirectUri))
        {
            var response = await ApiService.GetResponseAsync(
                $"api/sso/clients/{Uri.EscapeDataString(ClientId)}?redirectUri={Uri.EscapeDataString(PostLogoutRedirectUri)}");

            if (response.IsSuccessStatusCode)
            {
                var url = PostLogoutRedirectUri;
                if (!string.IsNullOrEmpty(State))
                {
                    url += (url.Contains('?') ? "&" : "?") + "state=" + Uri.EscapeDataString(State);
                }
                Navigation.NavigateTo(url, forceLoad: true);
                return;
            }
        }

        redirecting = false;
    }
}
