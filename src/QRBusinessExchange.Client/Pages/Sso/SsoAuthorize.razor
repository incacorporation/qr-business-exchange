@page "/sso/authorize"
@using QRBusinessExchange.Client.Services
@using QRBusinessExchange.Client.Components.Auth
@using QRBusinessExchange.Core.DTOs
@inject ApiService ApiService
@inject PortalAuthService PortalAuth
@inject StateService StateService
@inject NavigationManager Navigation

@* Sign-in page that business applications redirect users to.
   Query: client_id, redirect_uri, state, code_challenge, code_challenge_method, nonce, prompt=login *@

<PageTitle>Sign in@(client != null ? $" to {client.ApplicationName}" : "")</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">
            <div class="card shadow-lg border-0">
                <div class="card-body p-4 p-sm-5">

                    @if (fatalError != null)
                    {
                        <div class="text-center">
                            <i class="bi bi-shield-exclamation display-4 text-danger"></i>
                            <h4 class="mt-3">This sign-in link is not valid</h4>
                            <p class="text-muted">@fatalError</p>
                            <p class="small text-muted mb-0">
                                For your safety you have not been redirected. Return to the application and try again.
                            </p>
                        </div>
                    }
                    else if (client == null || busy)
                    {
                        <div class="text-center py-5">
                            <span class="spinner-border text-primary" role="status"></span>
                            <p class="text-muted mt-3 mb-0">@(busyText ?? "Loading…")</p>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-4">
                            @if (!string.IsNullOrEmpty(client.BusinessLogoUrl))
                            {
                                <img src="@client.BusinessLogoUrl" alt="" class="mb-3" style="max-height:64px;max-width:200px" />
                            }
                            else
                            {
                                <i class="bi bi-buildings display-5 text-primary"></i>
                            }
                            <h3 class="fw-bold mt-2 mb-1">Sign in to @client.ApplicationName</h3>
                            <p class="text-muted mb-0">
                                by @client.BusinessName
                                @if (!string.IsNullOrEmpty(client.BusinessWebsiteUrl))
                                {
                                    <span> · @client.BusinessWebsiteUrl</span>
                                }
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
                            </div>
                        }

                        @if (signedInUser != null && !needsPasskey)
                        {
                            <div class="d-grid gap-2 mb-4">
                                <button class="btn btn-primary btn-lg" @onclick="ContinueAsync">
                                    <i class="bi bi-person-check me-2"></i>Continue as @signedInUser.FirstName (@signedInUser.Email)
                                </button>
                                <button class="btn btn-link btn-sm" @onclick="UseAnotherAccountAsync">Use a different account</button>
                            </div>
                        }
                        else
                        {
                            @if (needsPasskey && signedInUser != null)
                            {
                                <div class="alert alert-info small">
                                    @client.ApplicationName requires a passkey. Confirm it's you, @signedInUser.FirstName.
                                </div>
                            }

                            <div class="row g-4 align-items-stretch">
                                <div class="col-12 col-md-6 d-flex flex-column justify-content-center">
                                    <h6 class="fw-semibold"><i class="bi bi-fingerprint me-1"></i>On this device</h6>
                                    <p class="text-muted small">Use Windows Hello, Touch ID, Face ID, Android, or a security key.</p>
                                    <button class="btn btn-primary btn-lg w-100" @onclick="PasskeySignInAsync">
                                        <i class="bi bi-key me-2"></i>Sign in with a passkey
                                    </button>
                                    <p class="small text-muted mt-3 mb-0">
                                        No passkey yet? <a href="/login">Sign in to your account</a> and add one under Settings.
                                    </p>
                                </div>
                                <div class="col-12 col-md-6 border-start-md">
                                    <h6 class="fw-semibold text-center"><i class="bi bi-qr-code-scan me-1"></i>With your phone</h6>
                                    <QrLoginPanel ClientId="@clientId" OnSuccess="OnSignedInAsync" />
                                </div>
                            </div>
                        }

                        <hr class="my-4" />
                        <div class="d-flex justify-content-between align-items-center small">
                            <span class="text-muted">
                                <i class="bi bi-shield-lock me-1"></i>@client.ApplicationName will receive your name and email.
                            </span>
                            <button class="btn btn-link btn-sm text-muted" @onclick="CancelAsync">Cancel</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "client_id")] public string? ClientIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "redirect_uri")] public string? RedirectUri { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    [SupplyParameterFromQuery(Name = "code_challenge")] public string? CodeChallenge { get; set; }
    [SupplyParameterFromQuery(Name = "code_challenge_method")] public string? CodeChallengeMethod { get; set; }
    [SupplyParameterFromQuery(Name = "nonce")] public string? Nonce { get; set; }
    [SupplyParameterFromQuery(Name = "prompt")] public string? Prompt { get; set; }

    private string? clientId;
    private SsoClientInfoDto? client;
    private UserProfileDto? signedInUser;
    private bool needsPasskey;
    private string? fatalError;
    private string? error;
    private bool busy;
    private string? busyText;

    protected override async Task OnInitializedAsync()
    {
        clientId = ClientIdParam;
        if (string.IsNullOrWhiteSpace(clientId) || string.IsNullOrWhiteSpace(RedirectUri))
        {
            fatalError = "The request is missing client_id or redirect_uri.";
            return;
        }

        var response = await ApiService.GetResponseAsync(
            $"api/sso/clients/{Uri.EscapeDataString(clientId)}?redirectUri={Uri.EscapeDataString(RedirectUri)}");

        if (!response.IsSuccessStatusCode)
        {
            fatalError = await ApiService.ReadErrorAsync(response, "Unknown application.");
            return;
        }

        client = await ApiService.ParseResponseAsync<SsoClientInfoDto>(response);

        if (await PortalAuth.HasSessionAsync())
        {
            signedInUser = StateService.CurrentUser;
            if (Prompt == "login")
            {
                needsPasskey = true;
            }
        }
    }

    private Task ContinueAsync() => AuthorizeAsync();

    private async Task UseAnotherAccountAsync()
    {
        await PortalAuth.SignOutAsync();
        signedInUser = null;
        needsPasskey = false;
    }

    private async Task PasskeySignInAsync()
    {
        error = null;
        try
        {
            busy = true;
            busyText = "Waiting for your passkey…";
            StateHasChanged();

            var auth = await PortalAuth.SignInWithPasskeyAsync();
            await OnSignedInAsync(auth);
        }
        catch (Exception ex)
        {
            busy = false;
            error = PortalAuthService.Describe(ex);
        }
    }

    private async Task OnSignedInAsync(AuthResponse auth)
    {
        signedInUser = auth.User;
        needsPasskey = false;
        await AuthorizeAsync();
    }

    private async Task AuthorizeAsync()
    {
        error = null;
        busy = true;
        busyText = $"Signing you in to {client?.ApplicationName}…";
        StateHasChanged();

        var response = await ApiService.PostAsync("api/sso/authorize", new SsoAuthorizeRequest
        {
            ClientId = clientId!,
            RedirectUri = RedirectUri!,
            State = State,
            CodeChallenge = CodeChallenge,
            CodeChallengeMethod = CodeChallengeMethod,
            Nonce = Nonce
        });

        if (response.IsSuccessStatusCode)
        {
            var result = await ApiService.ParseResponseAsync<SsoAuthorizeResponse>(response);
            if (result != null)
            {
                Navigation.NavigateTo(result.RedirectUrl, forceLoad: true);
                return;
            }
        }

        busy = false;
        var errorBody = await ApiService.ParseResponseAsync<SsoErrorResponse>(response);

        switch (response.StatusCode)
        {
            case System.Net.HttpStatusCode.Unauthorized:
                // Portal session expired
                await PortalAuth.SignOutAsync();
                signedInUser = null;
                error = "Your session has expired. Please sign in again.";
                break;
            case System.Net.HttpStatusCode.Forbidden when errorBody?.Error == "passkey_required":
                // Signed in with a password: SSO requires a passkey or QR approval
                needsPasskey = true;
                break;
            case System.Net.HttpStatusCode.Forbidden when errorBody?.Error == "access_denied":
                RedirectWithError("access_denied", errorBody.ErrorDescription);
                return;
            default:
                error = errorBody?.ErrorDescription ?? "Sign-in failed. Please try again.";
                break;
        }

        StateHasChanged();
    }

    private Task CancelAsync()
    {
        RedirectWithError("access_denied", "The user cancelled sign-in");
        return Task.CompletedTask;
    }

    /// <summary>Only used after the redirect URI was validated by the server.</summary>
    private void RedirectWithError(string code, string? description)
    {
        var separator = RedirectUri!.Contains('?') ? '&' : '?';
        var url = $"{RedirectUri}{separator}error={Uri.EscapeDataString(code)}";
        if (!string.IsNullOrEmpty(description)) url += $"&error_description={Uri.EscapeDataString(description)}";
        if (!string.IsNullOrEmpty(State)) url += $"&state={Uri.EscapeDataString(State)}";
        Navigation.NavigateTo(url, forceLoad: true);
    }
}

<style>
    @@media (min-width: 768px) {
        .border-start-md { border-left: 1px solid var(--bs-border-color); }
    }
</style>
