@page "/email-verification"
@layout AuthLayout
@using QRBusinessExchange.Client.Services
@inject ApiService ApiService
@inject IndexedDBService IndexedDB
@inject NavigationManager Navigation

<PageTitle>Email Verification - qrbound</PageTitle>

<div class="auth-medium">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4">Verify Email</h3>
                    <p class="text-center text-muted mb-4">
                        We've sent a verification code to your email address. Please enter it below.
                    </p>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            @successMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label for="code" class="form-label">Verification Code</label>
                        <input type="text" id="code" @bind="verificationCode" class="form-control text-center" 
                               placeholder="Enter 6-digit code" maxlength="6" />
                    </div>

                    <div class="d-grid">
                        <button @onclick="VerifyCode" class="btn btn-primary" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Verifying...</span>
                            }
                            else
                            {
                                <span>Verify Email</span>
                            }
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <button @onclick="ResendCode" class="btn btn-link" disabled="@(isResending || resendCooldown > 0)">
                            @if (isResending)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Resending...</span>
                            }
                            else if (resendCooldown > 0)
                            {
                                <span>Resend code in @resendCooldown seconds</span>
                            }
                            else
                            {
                                <span>Resend Code</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
</div>

@code {
    private string verificationCode = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = false;
    private bool isResending = false;
    private int resendCooldown = 0;
    private System.Threading.Timer? cooldownTimer;

    private async Task VerifyCode()
    {
        if (string.IsNullOrWhiteSpace(verificationCode) || verificationCode.Length != 6)
        {
            errorMessage = "Please enter a valid 6-digit code.";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            var userId = await IndexedDB.GetItemAsync<string>("userId");
            var response = await ApiService.PostAsync("api/auth/verify-email", new { UserId = userId, Code = verificationCode });
            
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Email verified successfully! Redirecting to dashboard...";
                StateHasChanged();
                await Task.Delay(2000);
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = "Invalid verification code. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResendCode()
    {
        isResending = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            var userId = await IndexedDB.GetItemAsync<string>("userId");
            var response = await ApiService.PostAsync("api/auth/resend-verification", new { UserId = userId });
            
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Verification code resent! Please check your email.";
                StartResendCooldown();
            }
            else
            {
                errorMessage = "Failed to resend code. Please try again later.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isResending = false;
            StateHasChanged();
        }
    }

    private void StartResendCooldown()
    {
        resendCooldown = 60;
        cooldownTimer = new System.Threading.Timer(_ =>
        {
            resendCooldown--;
            InvokeAsync(StateHasChanged);
            
            if (resendCooldown <= 0)
            {
                cooldownTimer?.Dispose();
            }
        }, null, 1000, 1000);
    }

    public void Dispose()
    {
        cooldownTimer?.Dispose();
    }
}
