@page "/register"
@using System.ComponentModel.DataAnnotations
@using QRBusinessExchange.Core.DTOs
@using QRBusinessExchange.Client.Services
@using QRBusinessExchange.Client.Components.Auth
@inject ApiService ApiService
@inject PortalAuthService PortalAuth
@inject WebAuthnService WebAuthn
@inject NavigationManager Navigation

<PageTitle>Create account - qrbound</PageTitle>

<div class="container-fluid min-vh-100 d-flex align-items-center py-4 px-3 px-sm-4">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

            <div class="text-center mb-4">
                <img src="images/qrbound-logo.png" class="brand-logo brand-logo-card" alt="qrbound - Let's get QR Bound" />
            </div>

            <!-- Progress -->
            <div class="d-flex justify-content-center gap-2 mb-3 small" aria-label="Progress">
                <span class="badge rounded-pill @(step == Step.Details ? "text-bg-primary" : "text-bg-success")">1 Account</span>
                <span class="badge rounded-pill @(step == Step.Passkey ? "text-bg-primary" : step == Step.Done ? "text-bg-success" : "text-bg-light border")">2 Passkey</span>
                <span class="badge rounded-pill @(step == Step.Done ? "text-bg-primary" : "text-bg-light border")">3 Done</span>
            </div>

            <div class="card shadow-lg border-0">
                <div class="card-body p-4 p-sm-5">

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                            <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
                        </div>
                    }

                    @if (step == Step.Details)
                    {
                        <h3 class="card-title text-center fw-bold mb-1">Create your account</h3>
                        <p class="text-center text-muted mb-4">Next, you'll add a passkey so you can sign in with your phone.</p>

                        <EditForm Model="form" OnValidSubmit="CreateAccountAsync">
                            <DataAnnotationsValidator />

                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <label for="firstName" class="form-label fw-semibold">First name</label>
                                    <InputText id="firstName" class="form-control" @bind-Value="form.FirstName" autocomplete="given-name" disabled="@working" />
                                    <ValidationMessage For="() => form.FirstName" />
                                </div>
                                <div class="col-sm-6">
                                    <label for="lastName" class="form-label fw-semibold">Last name</label>
                                    <InputText id="lastName" class="form-control" @bind-Value="form.LastName" autocomplete="family-name" disabled="@working" />
                                    <ValidationMessage For="() => form.LastName" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label fw-semibold">Email address</label>
                                <InputText id="email" type="email" class="form-control" @bind-Value="form.Email" autocomplete="email" placeholder="name@example.com" disabled="@working" />
                                <ValidationMessage For="() => form.Email" />
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <label for="company" class="form-label fw-semibold">Company <span class="text-muted fw-normal">(optional)</span></label>
                                    <InputText id="company" class="form-control" @bind-Value="form.CompanyName" autocomplete="organization" disabled="@working" />
                                </div>
                                <div class="col-sm-6">
                                    <label for="phone" class="form-label fw-semibold">Phone <span class="text-muted fw-normal">(optional)</span></label>
                                    <InputText id="phone" type="tel" class="form-control" @bind-Value="form.PhoneNumber" autocomplete="tel" disabled="@working" />
                                    <ValidationMessage For="() => form.PhoneNumber" />
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-sm-6">
                                    <label for="password" class="form-label fw-semibold">Password</label>
                                    <InputText id="password" type="password" class="form-control" @bind-Value="form.Password" autocomplete="new-password" disabled="@working" />
                                    <ValidationMessage For="() => form.Password" />
                                </div>
                                <div class="col-sm-6">
                                    <label for="confirm" class="form-label fw-semibold">Confirm password</label>
                                    <InputText id="confirm" type="password" class="form-control" @bind-Value="form.ConfirmPassword" autocomplete="new-password" disabled="@working" />
                                    <ValidationMessage For="() => form.ConfirmPassword" />
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg" disabled="@working">
                                    @if (working)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    Create account
                                </button>
                            </div>
                        </EditForm>

                        <p class="text-center text-muted small mt-4 mb-0">
                            Already have an account? <a href="@LoginHref" class="fw-semibold text-decoration-none">Sign in</a>
                        </p>
                    }
                    else if (step == Step.Passkey)
                    {
                        <h3 class="card-title text-center fw-bold mb-1">Add a passkey</h3>
                        <p class="text-center text-muted mb-4">
                            Passkeys replace your password with your fingerprint, face or screen lock. Business apps that
                            use qrbound sign-in require one.
                        </p>

                        @if (passkeyMode == PasskeyMode.Choose)
                        {
                            <div class="d-grid gap-3">
                                <button class="btn btn-outline-primary btn-lg text-start d-flex align-items-center p-3" @onclick="ShowPhoneQr">
                                    <i class="bi bi-qr-code-scan fs-2 me-3"></i>
                                    <span>
                                        <span class="fw-semibold d-block">Use my phone's camera</span>
                                        <span class="small text-muted">Scan a QR code and create the passkey on your phone</span>
                                    </span>
                                </button>

                                @if (passkeysSupported)
                                {
                                    <button class="btn btn-outline-primary btn-lg text-start d-flex align-items-center p-3" @onclick="CreatePasskeyHereAsync" disabled="@working">
                                        @if (working)
                                        {
                                            <span class="spinner-border me-3"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-fingerprint fs-2 me-3"></i>
                                        }
                                        <span>
                                            <span class="fw-semibold d-block">Use this device</span>
                                            <span class="small text-muted">Windows Hello, Touch ID, Face ID or a security key</span>
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <LinkPhonePanel AutoStart="true" OnLinked="OnPhoneLinked" />
                            <div class="text-center mt-2">
                                <button class="btn btn-link btn-sm" @onclick="() => passkeyMode = PasskeyMode.Choose">Back</button>
                            </div>
                        }

                        <div class="text-center mt-4">
                            <button class="btn btn-link btn-sm text-muted" @onclick="Finish">Skip for now</button>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">
                            <i class="bi bi-check-circle-fill display-3 text-success"></i>
                            <h3 class="fw-bold mt-3">You're all set</h3>
                            @if (passkeyWhere != null)
                            {
                                <p class="text-muted">
                                    Your passkey is on <strong>@passkeyWhere</strong>.
                                    @if (passkeyWhere != "this device")
                                    {
                                        <span>Next time, choose "Scan with your phone" on the sign-in page and scan the QR code with that phone.</span>
                                    }
                                </p>
                            }
                            else
                            {
                                <p class="text-muted">You can add a passkey or link your phone later in <strong>Settings</strong>.</p>
                            }
                            <p class="text-muted small">We sent a verification link to <strong>@form.Email</strong>.</p>
                            <button class="btn btn-primary btn-lg" @onclick="Continue">Continue</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private enum Step { Details, Passkey, Done }
    private enum PasskeyMode { Choose, Phone }

    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private readonly RegisterForm form = new();
    private Step step = Step.Details;
    private PasskeyMode passkeyMode = PasskeyMode.Choose;
    private bool working;
    private bool passkeysSupported;
    private string? errorMessage;
    private string? passkeyWhere;

    private string? SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : null;

    private string LoginHref => SafeReturnUrl == null ? "/login" : $"/login?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            passkeysSupported = await WebAuthn.IsSupportedAsync();
        }
        catch
        {
            passkeysSupported = false;
        }
    }

    private async Task CreateAccountAsync()
    {
        working = true;
        errorMessage = null;
        try
        {
            var response = await ApiService.PostAsync("api/auth/register", new RegisterRequest
            {
                Email = form.Email.Trim(),
                Password = form.Password,
                FirstName = form.FirstName.Trim(),
                LastName = form.LastName.Trim(),
                CompanyName = string.IsNullOrWhiteSpace(form.CompanyName) ? null : form.CompanyName.Trim(),
                PhoneNumber = string.IsNullOrWhiteSpace(form.PhoneNumber) ? null : form.PhoneNumber.Trim()
            });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ApiService.ReadErrorAsync(response, "Could not create the account.");
                return;
            }

            var auth = await ApiService.ParseResponseAsync<AuthResponse>(response)
                ?? throw new InvalidOperationException("Invalid response from the server.");

            await PortalAuth.SaveSessionAsync(auth);
            form.Password = form.ConfirmPassword = string.Empty;
            step = Step.Passkey;
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not reach the server: {ex.Message}";
        }
        finally
        {
            working = false;
        }
    }

    private void ShowPhoneQr()
    {
        errorMessage = null;
        passkeyMode = PasskeyMode.Phone;
    }

    private async Task CreatePasskeyHereAsync()
    {
        working = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            const string deviceName = "This computer";
            var init = await ApiService.PostAsync("api/passkey/register/init", new PasskeyRegistrationInitRequest { DeviceName = deviceName });
            if (!init.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ApiService.ReadErrorAsync(init, "Could not start creating the passkey."));
            }

            var options = await ApiService.ParseResponseAsync<PasskeyRegistrationOptionsDto>(init)
                ?? throw new InvalidOperationException("Invalid passkey options.");

            var credential = await PortalAuth.CreatePasskeyAsync(options);

            var complete = await ApiService.PostAsync("api/passkey/register/complete", new PasskeyRegistrationCompleteRequest
            {
                Challenge = options.Challenge,
                Credential = credential,
                DeviceName = deviceName
            });

            if (!complete.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ApiService.ReadErrorAsync(complete, "The passkey could not be saved."));
            }

            passkeyWhere = "this device";
            step = Step.Done;
        }
        catch (Exception ex)
        {
            errorMessage = PortalAuthService.Describe(ex);
        }
        finally
        {
            working = false;
        }
    }

    private void OnPhoneLinked()
    {
        passkeyWhere = "your phone";
        step = Step.Done;
    }

    private void Finish() => step = Step.Done;

    private void Continue() => Navigation.NavigateTo(SafeReturnUrl ?? "/dashboard");

    private sealed class RegisterForm
    {
        [Required(ErrorMessage = "First name is required")]
        [StringLength(100)]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required")]
        [StringLength(100)]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        [StringLength(255)]
        public string Email { get; set; } = string.Empty;

        [StringLength(255)]
        public string? CompanyName { get; set; }

        [Phone(ErrorMessage = "Enter a valid phone number")]
        [StringLength(20)]
        public string? PhoneNumber { get; set; }

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Use at least 8 characters")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords don't match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
