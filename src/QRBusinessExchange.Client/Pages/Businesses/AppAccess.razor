@page "/businesses/{BusinessId:guid}/applications/{ApplicationId:guid}/access"
@using QRBusinessExchange.Client.Services
@using QRBusinessExchange.Core.DTOs
@inject ApiService ApiService
@inject PortalAuthService PortalAuth
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* An application's user categories ("client", "business", "vip", ...) and who may use them.
   Linked from the approval emails sent to Owners and Admins. *@

<PageTitle>@(app?.Name ?? "Application") access - qrbound</PageTitle>

<div class="container mt-4 mb-5">
    <a href="@($"/businesses/{BusinessId}")" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> @(business?.Name ?? "Business")</a>

    @if (app == null || business == null)
    {
        <div class="text-center py-5">
            @if (error != null) { <div class="alert alert-danger">@error</div> }
            else { <span class="spinner-border text-primary"></span> }
        </div>
    }
    else
    {
        <h2 class="mt-2 mb-1">@app.Name</h2>
        <p class="text-muted">
            Categories and access · <code>@app.ClientId</code>
        </p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger alert-dismissible">
                @error
                <button type="button" class="btn-close" @onclick="() => error = null"></button>
            </div>
        }

        <!-- Requests and grants -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h5 class="card-title mb-0"><i class="bi bi-person-check me-2"></i>Who can sign in</h5>
                    <select class="form-select form-select-sm w-auto" value="@statusFilter" @onchange="OnFilterChangedAsync">
                        <option value="">All</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Revoked">Revoked</option>
                    </select>
                </div>

                @if (access == null)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else if (access.Count == 0)
                {
                    <p class="text-muted mb-0">
                        @(string.IsNullOrEmpty(statusFilter) ? "Nobody has requested access yet." : $"No {statusFilter.ToLowerInvariant()} requests.")
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>User</th><th>Category</th><th>Status</th><th>Message</th><th>Requested</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in access)
                                {
                                    <tr>
                                        <td>
                                            <div>@a.UserName</div>
                                            <div class="small text-muted">@a.UserEmail</div>
                                        </td>
                                        <td>
                                            @a.CategoryName
                                            @if (a.BusinessName != null)
                                            {
                                                <div class="small text-muted"><i class="bi bi-shop me-1"></i>@a.BusinessName</div>
                                            }
                                        </td>
                                        <td><span class="badge @Badge(a.Status)">@a.Status</span></td>
                                        <td class="small">
                                            @a.RequestNote
                                            @if (a.DecisionNote != null)
                                            {
                                                <div class="text-muted fst-italic">Reply: @a.DecisionNote</div>
                                            }
                                        </td>
                                        <td class="small text-nowrap">@Local(a.RequestedAt)</td>
                                        <td class="text-end text-nowrap">
                                            @if (CanManage)
                                            {
                                                @if (a.Status is "Pending" or "Rejected" or "Revoked")
                                                {
                                                    <button class="btn btn-sm btn-success" disabled="@saving" @onclick='() => DecideAsync(a, "approve")'>Approve</button>
                                                }
                                                @if (a.Status == "Pending")
                                                {
                                                    <button class="btn btn-sm btn-outline-danger ms-1" disabled="@saving" @onclick='() => DecideAsync(a, "reject")'>Reject</button>
                                                }
                                                @if (a.Status == "Approved")
                                                {
                                                    <button class="btn btn-sm btn-outline-danger" disabled="@saving" @onclick='() => DecideAsync(a, "revoke")'>Revoke</button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Categories -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0"><i class="bi bi-tags me-2"></i>Categories</h5>
                    @if (CanManage)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="NewCategory"><i class="bi bi-plus-lg me-1"></i>Add category</button>
                    }
                </div>
                <p class="small text-muted">
                    The kinds of users @app.Name recognises. Approved categories reach the app as <code>category</code> claims;
                    a category that acts for a business also sends <code>org_id</code>, <code>org_slug</code> and <code>org_name</code>.
                    Sites ask for one with <code>&lt;QrboundSignIn Category="business" /&gt;</code>.
                </p>

                @if (CanManage)
                {
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="requireApproved" checked="@app.RequireApprovedCategory"
                               disabled="@saving" @onchange="ToggleRequireApprovedAsync" />
                        <label class="form-check-label" for="requireApproved">Users need an approved category to sign in</label>
                    </div>
                }

                @if (editing != null)
                {
                    <div class="border rounded p-3 mb-3 bg-body-tertiary">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Key <span class="text-muted small">(claim value)</span></label>
                                <input class="form-control font-monospace" @bind="editing.Key" placeholder="business" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Name</label>
                                <input class="form-control" @bind="editing.Name" placeholder="Restaurant owner" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Order</label>
                                <input type="number" class="form-control" @bind="editing.SortOrder" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description <span class="text-muted small">(shown to users)</span></label>
                                <input class="form-control" @bind="editing.Description" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="catApproval" @bind="editing.RequiresApproval" />
                                    <label class="form-check-label" for="catApproval">Requires approval</label>
                                </div>
                                <small class="text-muted">Owners and Admins get an email for each request.</small>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="catBusiness" @bind="editing.RequiresBusiness" />
                                    <label class="form-check-label" for="catBusiness">Acts for a business</label>
                                </div>
                                <small class="text-muted">The user picks one of their businesses (Owner or Admin).</small>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="catDefault" @bind="editing.IsDefault"
                                           disabled="@(editing.RequiresApproval || editing.RequiresBusiness)" />
                                    <label class="form-check-label" for="catDefault">Default</label>
                                </div>
                                <small class="text-muted">Given to everyone who signs in. Only without approval or business.</small>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-primary" @onclick="SaveCategoryAsync" disabled="@saving">Save</button>
                            <button class="btn btn-link" @onclick="() => editing = null">Cancel</button>
                        </div>
                    </div>
                }

                @if (categories == null)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else if (categories.Count == 0)
                {
                    <p class="text-muted mb-0">No categories: everyone who signs in is treated the same.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Key</th><th>Name</th><th>Rules</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var c in categories)
                                {
                                    <tr>
                                        <td><code>@c.Key</code></td>
                                        <td>@c.Name<div class="small text-muted">@c.Description</div></td>
                                        <td>
                                            @if (c.RequiresApproval) { <span class="badge bg-warning text-dark me-1">approval</span> }
                                            @if (c.RequiresBusiness) { <span class="badge bg-info me-1">acts for a business</span> }
                                            @if (c.IsDefault) { <span class="badge bg-secondary me-1">default</span> }
                                            @if (!c.RequiresApproval && !c.RequiresBusiness && !c.IsDefault) { <span class="badge bg-light text-dark">open</span> }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (CanManage)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditCategory(c)">Edit</button>
                                                <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteCategoryAsync(c)"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid BusinessId { get; set; }
    [Parameter] public Guid ApplicationId { get; set; }

    private BusinessDto? business;
    private SsoApplicationDto? app;
    private List<SsoAppCategoryDto>? categories;
    private List<SsoAppAccessDto>? access;
    private SaveSsoAppCategoryRequest? editing;
    private Guid? editingId;
    private string statusFilter = "Pending";
    private bool saving;
    private string? error;

    private bool CanManage => business?.MyRole is "Owner" or "Admin" or "SuperAdmin";
    private string AppPath => $"api/businesses/{BusinessId}/applications/{ApplicationId}";

    protected override async Task OnInitializedAsync()
    {
        if (!await PortalAuth.HasSessionAsync())
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)}");
            return;
        }

        var response = await ApiService.GetResponseAsync($"api/businesses/{BusinessId}");
        if (!response.IsSuccessStatusCode)
        {
            error = await ApiService.ReadErrorAsync(response, "Business not found.");
            return;
        }

        business = await ApiService.ParseResponseAsync<BusinessDto>(response);
        var apps = await ApiService.GetAsync<List<SsoApplicationDto>>($"api/businesses/{BusinessId}/applications") ?? new();
        app = apps.FirstOrDefault(a => a.SsoApplicationId == ApplicationId);
        if (app == null)
        {
            error = "Application not found.";
            return;
        }

        await Task.WhenAll(LoadCategoriesAsync(), LoadAccessAsync());
    }

    private async Task LoadCategoriesAsync() =>
        categories = await ApiService.GetAsync<List<SsoAppCategoryDto>>($"{AppPath}/categories") ?? new();

    private async Task LoadAccessAsync()
    {
        var query = string.IsNullOrEmpty(statusFilter) ? "" : $"?status={Uri.EscapeDataString(statusFilter)}";
        access = await ApiService.GetAsync<List<SsoAppAccessDto>>($"{AppPath}/access{query}") ?? new();
    }

    private async Task OnFilterChangedAsync(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? "";
        access = null;
        await LoadAccessAsync();
    }

    private async Task DecideAsync(SsoAppAccessDto a, string action)
    {
        var verb = action switch { "approve" => "Approve", "reject" => "Reject", _ => "Revoke" };
        var note = await JS.InvokeAsync<string?>("prompt",
            $"{verb} {a.UserName} ({a.UserEmail}) as {a.CategoryName}?\n\nOptional message for the email to {a.UserEmail}:", "");
        if (note == null) return; // cancelled

        var result = await SendAsync<SsoAppAccessDto>(ApiService.PostAsync($"{AppPath}/access/{a.SsoAppAccessId}/{action}",
            new SsoAccessDecisionRequest { Note = string.IsNullOrWhiteSpace(note) ? null : note }));
        if (result != null) await LoadAccessAsync();
    }

    private void NewCategory()
    {
        editingId = null;
        editing = new SaveSsoAppCategoryRequest { RequiresApproval = true, SortOrder = (categories?.Count ?? 0) * 10 };
    }

    private void EditCategory(SsoAppCategoryDto c)
    {
        editingId = c.SsoAppCategoryId;
        editing = new SaveSsoAppCategoryRequest
        {
            Key = c.Key,
            Name = c.Name,
            Description = c.Description,
            RequiresApproval = c.RequiresApproval,
            IsDefault = c.IsDefault,
            RequiresBusiness = c.RequiresBusiness,
            SortOrder = c.SortOrder
        };
    }

    private async Task SaveCategoryAsync()
    {
        if (editing == null) return;
        if (editing.RequiresApproval || editing.RequiresBusiness) editing.IsDefault = false;

        var request = editingId is { } id
            ? ApiService.PutAsync($"{AppPath}/categories/{id}", editing)
            : ApiService.PostAsync($"{AppPath}/categories", editing);

        if (await SendAsync<SsoAppCategoryDto>(request) != null)
        {
            editing = null;
            await LoadCategoriesAsync();
        }
    }

    private async Task DeleteCategoryAsync(SsoAppCategoryDto c)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Delete the category \"{c.Name}\"? Everyone's access and pending requests for it are deleted too, and they can't sign in as {c.Key} any more. This cannot be undone.")) return;

        if (await SendAsync<object>(ApiService.DeleteAsync($"{AppPath}/categories/{c.SsoAppCategoryId}")) != null)
        {
            await Task.WhenAll(LoadCategoriesAsync(), LoadAccessAsync());
        }
    }

    private async Task ToggleRequireApprovedAsync(ChangeEventArgs e)
    {
        var updated = await SendAsync<SsoApplicationDto>(ApiService.PutAsync(AppPath, new UpdateSsoApplicationRequest
        {
            Name = app!.Name,
            RedirectUris = app.RedirectUris,
            RequireMembership = app.RequireMembership,
            RequireApprovedCategory = e.Value is true,
            TokenLifetimeMinutes = app.TokenLifetimeMinutes,
            IsActive = app.IsActive
        }));
        if (updated != null) app = updated;
    }

    private static string Badge(string status) => status switch
    {
        "Approved" => "bg-success",
        "Pending" => "bg-warning text-dark",
        _ => "bg-danger"
    };

    private static string Local(DateTime utc) => DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("g");

    private async Task<T?> SendAsync<T>(Task<HttpResponseMessage> request) where T : class
    {
        saving = true;
        error = null;
        try
        {
            var response = await request;
            if (!response.IsSuccessStatusCode)
            {
                error = await ApiService.ReadErrorAsync(response, "The request failed.");
                return null;
            }

            return typeof(T) == typeof(object)
                ? (T)new object()
                : await ApiService.ParseResponseAsync<T>(response);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            return null;
        }
        finally
        {
            saving = false;
        }
    }
}
