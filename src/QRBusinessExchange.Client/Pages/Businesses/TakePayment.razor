@page "/businesses/{BusinessId:guid}/payments"
@using System.Globalization
@implements IAsyncDisposable
@inject ApiService ApiService
@inject PortalAuthService PortalAuth
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Staff take a card payment: enter an amount, show the QR code, and watch it get paid.
   The customer scans it with their phone camera and pays on /pay/{id}; no account needed. *@

<PageTitle>Take a payment - @(business?.Name ?? "qrbound")</PageTitle>

<div class="page-wide">
    <a href="@($"/businesses/{BusinessId}")" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> @(business?.Name ?? "Business")</a>

    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 gap-2 flex-wrap">
        <h2 class="mb-0"><i class="bi bi-qr-code me-2"></i>Take a payment</h2>
        @if (paySettings?.CanEdit == true)
        {
            <a class="btn btn-outline-secondary btn-sm" href="@($"/businesses/{BusinessId}/payments/settings")">
                <i class="bi bi-sliders me-1"></i>Payment settings &amp; report
            </a>
        }
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger alert-dismissible">
            @error
            <button type="button" class="btn-close" @onclick="() => error = null"></button>
        </div>
    }

    @if (business == null)
    {
        @if (error == null) { <div class="text-center py-5"><span class="spinner-border text-primary"></span></div> }
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-5">
                @if (current == null && paySettings?.CanTakePayments != true)
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Payments aren't available</h5>
                            @if (paySettings == null)
                            {
                                <p class="text-muted mb-0">The payment settings couldn't be loaded.</p>
                            }
                            else if (!paySettings.PaymentsEnabled)
                            {
                                <p class="text-muted">This business hasn't turned payments on.</p>
                                @if (paySettings.CanEdit)
                                {
                                    <a class="btn btn-primary" href="@($"/businesses/{BusinessId}/payments/settings")">Turn on payments</a>
                                }
                                else
                                {
                                    <p class="small text-muted mb-0">Ask one of its Owners or Admins to turn them on.</p>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">In this business only Owners and Admins can take payments.</p>
                            }
                        </div>
                    </div>
                }
                else if (current == null)
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-3">New payment</h5>
                            <div class="mb-3">
                                <label class="form-label" for="pay-amount">Amount (USD) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input id="pay-amount" class="form-control form-control-lg" inputmode="decimal" placeholder="0.00"
                                           @bind="amountText" @bind:event="oninput" disabled="@creating" />
                                </div>
                                <div class="form-text">@Money(paySettings!.EffectiveMinAmountCents) to @Money(paySettings.EffectiveMaxAmountCents)</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="pay-description">Description</label>
                                <input id="pay-description" class="form-control" maxlength="250" placeholder="e.g. Order 42, 2 lattes"
                                       @bind="description" @bind:event="oninput" disabled="@creating" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="pay-expiry">QR code works for</label>
                                <select id="pay-expiry" class="form-select" @bind="expiresInMinutes" disabled="@creating">
                                    <option value="15">15 minutes</option>
                                    <option value="30">30 minutes</option>
                                    <option value="60">1 hour</option>
                                    <option value="240">4 hours</option>
                                    <option value="1440">24 hours</option>
                                </select>
                            </div>
                            <button class="btn btn-success btn-lg w-100" disabled="@creating" @onclick="CreateAsync">
                                @if (creating) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                Show QR code
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm text-center">
                        <div class="card-body">
                            <p class="text-muted mb-1">@business.Name</p>
                            <p class="display-6 fw-bold mb-1">@Money(current.AmountCents)</p>
                            @if (!string.IsNullOrEmpty(current.Description))
                            {
                                <p class="text-muted mb-3">@current.Description</p>
                            }

                            @if (current.Status == QrPaymentStates.Paid)
                            {
                                <div class="alert alert-success my-3" role="status">
                                    <div class="fs-4"><i class="bi bi-check-circle-fill me-2"></i>Paid @Money(current.PaidAmountCents ?? current.AmountCents)</div>
                                    @if (current.TipCents > 0)
                                    {
                                        <div class="small">Bill @Money(current.AmountCents) + tip @Money(current.TipCents)</div>
                                    }
                                    <div class="small">
                                        @if (!string.IsNullOrEmpty(current.PayerName)) { <text>by @current.PayerName · </text> }
                                        @if (MethodText(current.PaymentMethod) is { } how) { <text>@how · </text> }
                                        ref @current.TransactionId
                                    </div>
                                    @if (!string.IsNullOrEmpty(current.LastError))
                                    {
                                        <div class="small text-warning-emphasis mt-1">@current.LastError</div>
                                    }
                                </div>
                            }
                            else if (current.Status is QrPaymentStates.Open or QrPaymentStates.Processing)
                            {
                                <PaymentQrCode Value="@PayUrl(current.Id)" Title="@($"Pay {Money(current.AmountCents)} to {business.Name}")" Size="min(18rem, 100%)" />
                                <p class="mt-3 mb-1 fw-semibold">
                                    @if (current.Status == QrPaymentStates.Processing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span><text>Payment in progress…</text>
                                    }
                                    else
                                    {
                                        <text>Scan with your phone camera to pay</text>
                                    }
                                </p>
                                <p class="small text-muted mb-2">
                                    Works until @current.ExpiresAt.ToLocalTime().ToString("t") · @current.InvoiceNumber
                                    @if (current.FailedAttempts > 0)
                                    {
                                        <br /><span class="text-danger">@current.FailedAttempts declined @(current.FailedAttempts == 1 ? "attempt" : "attempts"): @current.LastError</span>
                                    }
                                    @if (current.HostedStartedAt != null && current.Status == QrPaymentStates.Open)
                                    {
                                        <br /><span class="text-primary">The customer opened Fiserv's secure card page. This updates when they've paid.</span>
                                    }
                                </p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => CopyAsync(PayUrl(current.Id))">
                                        <i class="bi bi-link-45deg"></i> @(copied ? "Copied" : "Copy link")
                                    </button>
                                    @if (current.Status == QrPaymentStates.Open && CanCancel)
                                    {
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => CancelAsync(current.Id)">Cancel</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert @(current.Status == QrPaymentStates.NeedsReview ? "alert-warning" : "alert-secondary") my-3" role="status">
                                    <div class="fw-semibold">@StatusText(current.Status)</div>
                                    <div class="small">@StatusHelp(current)</div>
                                    @if (current.Status == QrPaymentStates.NeedsReview || (current.Status == QrPaymentStates.Expired && current.HostedStartedAt != null))
                                    {
                                        <button class="btn btn-outline-primary btn-sm mt-2" @onclick="() => CheckGatewayAsync(current.Id)">Check with CardPointe</button>
                                    }
                                </div>
                            }

                            <button class="btn btn-success w-100 mt-3" @onclick="NewPayment">New payment</button>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="card-title mb-0">Recent payments</h5>
                            <button class="btn btn-link btn-sm" @onclick="LoadRecentAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
                        </div>
                        @if (recent == null)
                        {
                            <div class="text-center py-3"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                        }
                        else if (recent.Count == 0)
                        {
                            <p class="text-muted small mb-0">No payments yet.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr><th>When</th><th class="text-end">Amount</th><th>For</th><th>Status</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in recent)
                                        {
                                            <tr>
                                                <td class="small text-nowrap">@p.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                                <td class="text-end text-nowrap">
                                                    @Money(p.PaidAmountCents ?? p.AmountCents)
                                                    @if (p.TipCents > 0) { <div class="small text-muted">incl. tip @Money(p.TipCents)</div> }
                                                </td>
                                                <td class="small">
                                                    @(p.Description ?? "—")
                                                    @if (!string.IsNullOrEmpty(p.PayerName)) { <div class="text-muted">@p.PayerName</div> }
                                                    @if (MethodText(p.PaymentMethod) is { } how && p.Status == QrPaymentStates.Paid) { <div class="text-muted">@how</div> }
                                                    @if (!string.IsNullOrEmpty(p.ExtraTransactionId))
                                                    {
                                                        <div class="text-danger">Refund extra charge @p.ExtraTransactionId in CardPointe</div>
                                                    }
                                                </td>
                                                <td><span class="badge @StatusBadge(p.Status)">@StatusText(p.Status)</span></td>
                                                <td class="text-end text-nowrap">
                                                    @if (p.Status is QrPaymentStates.Open or QrPaymentStates.Processing)
                                                    {
                                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => Show(p)">Show QR</button>
                                                    }
                                                    @if (p.Status is QrPaymentStates.Open or QrPaymentStates.Locked && CanCancel)
                                                    {
                                                        <button class="btn btn-link btn-sm text-danger" @onclick="() => CancelAsync(p.Id)">Cancel</button>
                                                    }
                                                    @if (p.Status == QrPaymentStates.NeedsReview || (p.Status == QrPaymentStates.Expired && p.HostedStartedAt != null))
                                                    {
                                                        <button class="btn btn-outline-primary btn-sm" title="Ask CardPointe whether this bill was paid" @onclick="() => CheckGatewayAsync(p.Id)">Check</button>
                                                    }
                                                    @if (p.Status == QrPaymentStates.NeedsReview && paySettings?.CanEdit == true)
                                                    {
                                                        <button class="btn btn-outline-success btn-sm" @onclick="() => ResolveAsync(p.Id, true)">It was paid</button>
                                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ResolveAsync(p.Id, false)">Not charged</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid BusinessId { get; set; }

    private BusinessDto? business;
    private BusinessPaymentSettingsDto? paySettings;
    private QrPaymentDetails? current;
    private List<QrPaymentDetails>? recent;
    private string amountText = string.Empty;
    private string description = string.Empty;
    private int expiresInMinutes = 30;
    private bool creating;
    private bool copied;
    private string? error;
    private CancellationTokenSource? polling;

    private string Api => $"api/businesses/{BusinessId}/qr-payments";

    /// <summary>Whoever may take payments here may cancel them, even with payments turned off.</summary>
    private bool CanCancel => paySettings != null && (!paySettings.ManagersOnly || paySettings.CanEdit);

    protected override async Task OnInitializedAsync()
    {
        if (!await PortalAuth.HasSessionAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var response = await ApiService.GetResponseAsync($"api/businesses/{BusinessId}");
        if (!response.IsSuccessStatusCode)
        {
            error = await ApiService.ReadErrorAsync(response, "Business not found.");
            return;
        }

        business = await ApiService.ParseResponseAsync<BusinessDto>(response);
        paySettings = await ApiService.GetAsync<BusinessPaymentSettingsDto>($"api/businesses/{BusinessId}/payment-settings");
        if (paySettings != null)
        {
            expiresInMinutes = paySettings.DefaultExpiresInMinutes;
        }

        await LoadRecentAsync();
    }

    private async Task LoadRecentAsync() =>
        recent = await ApiService.GetAsync<List<QrPaymentDetails>>(Api) ?? new();

    private async Task CreateAsync()
    {
        error = null;
        if (!TryParseCents(amountText, out var cents) || cents <= 0)
        {
            error = "Enter an amount, like 12.50.";
            return;
        }

        creating = true;
        try
        {
            var response = await ApiService.PostAsync(Api, new CreateQrPaymentRequest
            {
                AmountCents = cents,
                Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
                ExpiresInMinutes = expiresInMinutes
            });

            if (!response.IsSuccessStatusCode)
            {
                error = await ApiService.ReadErrorAsync(response, "The payment couldn't be created.");
                return;
            }

            Show((await ApiService.ParseResponseAsync<QrPaymentDetails>(response))!);
            await LoadRecentAsync();
        }
        finally
        {
            creating = false;
        }
    }

    private void Show(QrPaymentDetails payment)
    {
        current = payment;
        copied = false;
        StartPolling();
    }

    private void NewPayment()
    {
        StopPolling();
        current = null;
        amountText = string.Empty;
        description = string.Empty;
    }

    /// <summary>Checks the shown payment every 2 seconds until it's paid or can't be paid any more.</summary>
    private void StartPolling()
    {
        StopPolling();
        var cts = polling = new CancellationTokenSource();
        _ = PollAsync(cts.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        var ticks = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (current == null || QrPaymentStates.IsFinal(current.Status) || current.Status == QrPaymentStates.NeedsReview)
                {
                    return;
                }

                // When the customer is paying on Fiserv's hosted page, also ask CardPointe now and then,
                // in case the hosted page's webhook doesn't reach qrbound.
                ticks++;
                QrPaymentDetails? latest;
                if (current.HostedStartedAt != null && ticks % 8 == 0)
                {
                    var checkResponse = await ApiService.PostAsync<object?>($"{Api}/{current.Id}/check-gateway", null);
                    latest = checkResponse.IsSuccessStatusCode ? await ApiService.ParseResponseAsync<QrPaymentDetails>(checkResponse) : null;
                }
                else
                {
                    latest = await ApiService.GetAsync<QrPaymentDetails>($"{Api}/{current.Id}");
                }

                if (token.IsCancellationRequested || latest == null || current?.Id != latest.Id)
                {
                    continue;
                }

                var changed = latest.Status != current.Status || latest.FailedAttempts != current.FailedAttempts;
                current = latest;
                if (changed)
                {
                    await LoadRecentAsync();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopPolling()
    {
        polling?.Cancel();
        polling?.Dispose();
        polling = null;
    }

    private async Task CancelAsync(Guid id)
    {
        var response = await ApiService.PostAsync<object?>($"{Api}/{id}/cancel", null);
        await AfterActionAsync(response, "The payment couldn't be cancelled.");
    }

    private async Task ResolveAsync(Guid id, bool paid)
    {
        var question = paid
            ? "Mark this payment as paid? Only do this if CardPointe shows the charge went through."
            : "Mark this payment as not charged? The customer can then pay again with the same QR code.";
        if (!await JS.InvokeAsync<bool>("confirm", question))
        {
            return;
        }

        var response = await ApiService.PostAsync($"{Api}/{id}/resolve", new ResolveQrPaymentRequest { Paid = paid });
        await AfterActionAsync(response, "The payment couldn't be updated.");
    }

    /// <summary>Asks CardPointe about the bill's order and records any approved payment it has.</summary>
    private async Task CheckGatewayAsync(Guid id)
    {
        error = null;
        var response = await ApiService.PostAsync<object?>($"{Api}/{id}/check-gateway", null);
        await AfterActionAsync(response, "CardPointe couldn't be checked. Try again.");
    }

    private static string? MethodText(string? method) => method switch
    {
        Qrbound.Payments.Models.QrPaymentMethods.SavedCard => "saved card + fingerprint",
        Qrbound.Payments.Models.QrPaymentMethods.HostedPage => "Fiserv secure card page",
        Qrbound.Payments.Models.QrPaymentMethods.Card => "card",
        _ => null
    };

    private async Task AfterActionAsync(HttpResponseMessage response, string fallback)
    {
        if (!response.IsSuccessStatusCode)
        {
            error = await ApiService.ReadErrorAsync(response, fallback);
            return;
        }

        var updated = await ApiService.ParseResponseAsync<QrPaymentDetails>(response);
        if (updated != null && current?.Id == updated.Id)
        {
            current = updated;
            if (updated.Status == QrPaymentStates.Open)
            {
                StartPolling();
            }
        }
        await LoadRecentAsync();
    }

    private async Task CopyAsync(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        copied = true;
    }

    private string PayUrl(Guid id) => $"{Navigation.BaseUri}pay/{id}";

    private static string Money(long cents) => (cents / 100m).ToString("C2", CultureInfo.GetCultureInfo("en-US"));

    private static bool TryParseCents(string? text, out long cents)
    {
        cents = 0;
        var cleaned = (text ?? string.Empty).Trim().TrimStart('$').Replace(",", string.Empty);
        if (!decimal.TryParse(cleaned, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var amount))
        {
            return false;
        }

        var scaled = amount * 100m;
        if (scaled != decimal.Truncate(scaled) || scaled > long.MaxValue)
        {
            return false;
        }

        cents = (long)scaled;
        return true;
    }

    private static string StatusText(string status) => status switch
    {
        QrPaymentStates.Open => "Waiting",
        QrPaymentStates.Processing => "Processing",
        QrPaymentStates.Paid => "Paid",
        QrPaymentStates.Cancelled => "Cancelled",
        QrPaymentStates.Expired => "Expired",
        QrPaymentStates.Locked => "Locked: too many declines",
        QrPaymentStates.NeedsReview => "Check in CardPointe",
        _ => status
    };

    private static string StatusHelp(QrPaymentDetails p) => p.Status switch
    {
        QrPaymentStates.NeedsReview when !string.IsNullOrEmpty(p.TransactionId) && !string.IsNullOrEmpty(p.LastError) => p.LastError!,
        QrPaymentStates.NeedsReview => $"CardPointe didn't answer in time, so we don't know if {p.PayerName ?? "the customer"} was charged. Press Check with CardPointe, or look up {p.InvoiceNumber} in CardPointe, then mark it in Recent payments.",
        QrPaymentStates.Locked => "The card was declined too many times. Start a new payment.",
        QrPaymentStates.Expired => "Nobody paid before the QR code expired. Start a new payment.",
        QrPaymentStates.Cancelled => "This payment was cancelled.",
        _ => string.Empty
    };

    private static string StatusBadge(string status) => status switch
    {
        QrPaymentStates.Paid => "bg-success",
        QrPaymentStates.Open or QrPaymentStates.Processing => "bg-primary",
        QrPaymentStates.NeedsReview or QrPaymentStates.Locked => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}
