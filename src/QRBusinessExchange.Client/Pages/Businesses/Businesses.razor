@page "/businesses"
@using QRBusinessExchange.Client.Services
@using QRBusinessExchange.Core.DTOs
@inject ApiService ApiService
@inject PortalAuthService PortalAuth
@inject NavigationManager Navigation

<PageTitle>Business Profile - qrbound</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                Business Profile
                @if (access?.IsSuperAdmin == true)
                {
                    <span class="badge bg-danger align-middle fs-6 ms-2" title="You can see and manage every business">SuperAdmin</span>
                }
            </h2>
            <p class="text-muted mb-0">
                @if (access?.IsSuperAdmin == true)
                {
                    <text>All @access.BusinessCount businesses on qrbound. You have full access to each of them.</text>
                }
                else
                {
                    <text>Each business can register apps that sign users in with passkeys and QR codes.</text>
                }
            </p>
        </div>
        <button class="btn btn-primary" @onclick="() => showCreate = !showCreate">
            <i class="bi bi-plus-lg me-1"></i>New business
        </button>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (showCreate)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">Create a business</h5>
                <EditForm Model="createModel" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="createModel.Name" />
                            <ValidationMessage For="() => createModel.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Slug <span class="text-muted small">(optional)</span></label>
                            <InputText class="form-control" @bind-Value="createModel.Slug" placeholder="acme-coffee" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Website</label>
                            <InputText class="form-control" @bind-Value="createModel.WebsiteUrl" placeholder="https://example.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Logo URL</label>
                            <InputText class="form-control" @bind-Value="createModel.LogoUrl" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="createModel.Description" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" disabled="@saving">Create</button>
                        <button type="button" class="btn btn-link" @onclick="() => showCreate = false">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (businesses == null)
    {
        <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
    }
    else if (businesses.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-buildings display-4"></i>
            <p class="mt-3">You don't belong to any business yet. Create one to register your first SSO app.</p>
        </div>
    }
    else
    {
        <div class="row g-2 mb-3">
            <div class="col-md-6">
                <input class="form-control" placeholder="Search by name, slug or owner email" @bind="search" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="filter">
                    <option value="all">All businesses</option>
                    <option value="managed">Businesses I manage</option>
                    <option value="active">Active only</option>
                    <option value="disabled">Disabled only</option>
                </select>
            </div>
            <div class="col-md-3 text-md-end small text-muted align-self-center">
                Showing @Filtered.Count() of @businesses.Count
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Business</th>
                        <th>Owner</th>
                        <th>Your access</th>
                        <th class="text-center">Apps</th>
                        <th class="text-center">Members</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Filtered)
                    {
                        <tr>
                            <td>
                                <a href="/businesses/@b.BusinessId" class="fw-semibold text-decoration-none">@b.Name</a>
                                <div class="small text-muted">@b.Slug</div>
                            </td>
                            <td class="small">@b.OwnerEmail</td>
                            <td>
                                <span class="badge @RoleBadge(b.MyRole)">@b.MyRole</span>
                                @foreach (var r in b.MyRoles.Where(r => r != "SuperAdmin"))
                                {
                                    <span class="badge bg-light text-dark border ms-1">@r</span>
                                }
                            </td>
                            <td class="text-center">@b.ApplicationCount</td>
                            <td class="text-center">@b.MemberCount</td>
                            <td><span class="badge @(b.IsActive ? "bg-success" : "bg-secondary")">@(b.IsActive ? "Active" : "Disabled")</span></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="/businesses/@b.BusinessId">
                                    <i class="bi bi-gear me-1"></i>@(CanManage(b) ? "Manage" : "Open")
                                </a>
                                @if (CanManage(b))
                                {
                                    <button class="btn btn-sm btn-outline-secondary ms-1" disabled="@saving" @onclick="() => ToggleActiveAsync(b)">
                                        @(b.IsActive ? "Disable" : "Enable")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<BusinessDto>? businesses;
    private MyBusinessAccessDto? access;
    private CreateBusinessRequest createModel = new();
    private bool showCreate;
    private bool saving;
    private string? error;
    private string search = string.Empty;
    private string filter = "all";

    private static bool CanManage(BusinessDto b) => b.MyRole is "Owner" or "Admin" or "SuperAdmin";

    private static string RoleBadge(string role) => role switch
    {
        "SuperAdmin" => "bg-danger",
        "Owner" => "bg-primary",
        "Admin" => "bg-info text-dark",
        _ => "bg-light text-dark border"
    };

    private IEnumerable<BusinessDto> Filtered => (businesses ?? new())
        .Where(b => filter switch
        {
            "managed" => CanManage(b),
            "active" => b.IsActive,
            "disabled" => !b.IsActive,
            _ => true
        })
        .Where(b => string.IsNullOrWhiteSpace(search) ||
                    b.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    b.Slug.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    (b.OwnerEmail ?? string.Empty).Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    private async Task ToggleActiveAsync(BusinessDto b)
    {
        saving = true;
        error = null;
        try
        {
            var response = await ApiService.PutAsync($"api/businesses/{b.BusinessId}", new UpdateBusinessRequest
            {
                Name = b.Name,
                Description = b.Description,
                WebsiteUrl = b.WebsiteUrl,
                LogoUrl = b.LogoUrl,
                IsActive = !b.IsActive
            });
            if (!response.IsSuccessStatusCode)
            {
                error = await ApiService.ReadErrorAsync(response, "Could not change the business.");
                return;
            }
            await LoadAsync();
        }
        finally
        {
            saving = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await PortalAuth.HasSessionAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var businessesTask = ApiService.GetAsync<List<BusinessDto>>("api/businesses");
        var accessTask = ApiService.GetAsync<MyBusinessAccessDto>("api/businesses/access");
        businesses = await businessesTask ?? new List<BusinessDto>();
        access = await accessTask;
    }

    private async Task CreateAsync()
    {
        saving = true;
        error = null;
        try
        {
            var response = await ApiService.PostAsync("api/businesses", createModel);
            if (!response.IsSuccessStatusCode)
            {
                error = await ApiService.ReadErrorAsync(response, "Could not create the business.");
                return;
            }

            var created = await ApiService.ParseResponseAsync<BusinessDto>(response);
            Navigation.NavigateTo($"/businesses/{created!.BusinessId}");
        }
        finally
        {
            saving = false;
        }
    }
}
