@page "/profile"
@using QRBusinessExchange.Core.DTOs
@using QRBusinessExchange.Client.Services
@using QRBusinessExchange.Client.Components.Profile
@inject ApiService ApiService
@inject StateService StateService
@inject PortalAuthService PortalAuth
@inject NavigationManager Navigation

<PageTitle>Edit Profile - qrbound</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="mb-4">Edit Profile</h3>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            @successMessage
                        </div>
                    }

                    @if (profileDto != null)
                    {
                        <EditForm Model="profileDto" OnValidSubmit="SaveProfile" FormName="profileForm">
                            <DataAnnotationsValidator />
                            
                            <p class="text-muted small mb-3">
                                Tick <strong>Show on my card</strong> for each detail that people who scan your business card,
                                and your contacts, may see. Unticked details stay visible only to you. Your name is always shown.
                            </p>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="firstName" class="form-label">First Name</label>
                                    <InputText id="firstName" @bind-Value="profileDto.FirstName" class="form-control" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="lastName" class="form-label">Last Name</label>
                                    <InputText id="lastName" @bind-Value="profileDto.LastName" class="form-control" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="profile-label-row">
                                    <label for="email" class="form-label">Email</label>
                                    <ShowOnCardCheckbox Id="show-email" Field="your email" @bind-Value="visibility.ShowEmail" />
                                </div>
                                <InputText id="email" @bind-Value="profileDto.Email" class="form-control" disabled />
                                <div class="form-text">
                                    "Show on card" only affects your business card. Apps and websites you sign in to with qrbound
                                    always receive this email address (it's how they recognise you), along with your name.
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="profile-label-row">
                                    <label for="companyName" class="form-label">Company Name</label>
                                    <ShowOnCardCheckbox Id="show-company" Field="your company name" @bind-Value="visibility.ShowCompanyName" />
                                </div>
                                <InputText id="companyName" @bind-Value="profileDto.CompanyName" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <div class="profile-label-row">
                                    <label for="phoneNumber" class="form-label">Phone Number</label>
                                    <ShowOnCardCheckbox Id="show-phone" Field="your phone number" @bind-Value="visibility.ShowPhoneNumber" />
                                </div>
                                <InputText id="phoneNumber" @bind-Value="profileDto.PhoneNumber" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <div class="profile-label-row">
                                    <label for="bio" class="form-label">Bio</label>
                                    <ShowOnCardCheckbox Id="show-bio" Field="your bio" @bind-Value="visibility.ShowBio" />
                                </div>
                                <InputTextArea id="bio" @bind-Value="profileDto.Bio" class="form-control" rows="4" />
                            </div>

                            <div class="mb-3">
                                <div class="profile-label-row">
                                    <label for="skills" class="form-label">Skills (comma-separated)</label>
                                    <ShowOnCardCheckbox Id="show-skills" Field="your skills" @bind-Value="visibility.ShowSkills" />
                                </div>
                                @* Read-only: choosing happens in the picker, which opens on click or focus. *@
                                <input id="skills" class="form-control skills-input" readonly value="@profileDto.Skills"
                                       placeholder="e.g., Web Development, Marketing, Design"
                                       aria-haspopup="dialog" title="Choose industries and skills"
                                       @onclick="OpenSkillsPicker" @onfocus="OpenSkillsPicker" />
                            </div>

                            <div class="mb-3">
                                <div class="profile-label-row">
                                    <label for="servicePricing" class="form-label">Service Pricing ($)</label>
                                    <ShowOnCardCheckbox Id="show-pricing" Field="your service pricing" @bind-Value="visibility.ShowServicePricing" />
                                </div>
                                <InputNumber id="servicePricing" @bind-Value="profileDto.ServicePricing" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <div class="profile-label-row">
                                    <label for="profileImage" class="form-label">Profile Picture or Logo</label>
                                    <ShowOnCardCheckbox Id="show-image" Field="your profile picture" @bind-Value="visibility.ShowProfileImage" />
                                </div>
                                <ProfilePictureUpload InputId="profileImage" OnChanged="OnPictureChanged" />
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>Save Changes</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                            </div>
                        </EditForm>

                        <SkillsPickerModal IsOpen="skillsPickerOpen" Value="@profileDto.Skills" OnClose="OnSkillsPicked" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private UserProfileDto? profileDto;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = false;
    private bool skillsPickerOpen;

    private void OpenSkillsPicker() => skillsPickerOpen = true;

    // A picture upload or removal is saved straight away: show it everywhere without waiting for Save Changes.
    private void OnPictureChanged(string? url)
    {
        if (profileDto != null)
        {
            profileDto.ProfileImageUrl = url;
        }
        if (StateService.CurrentUser is { } current)
        {
            var user = Copy(current);
            user.ProfileImageUrl = url;
            StateService.CurrentUser = user;
        }
    }

    // Close in the picker: put the chosen skills in the Skills box (saved with Save Changes).
    private void OnSkillsPicked(string skills)
    {
        skillsPickerOpen = false;
        if (profileDto != null)
        {
            profileDto.Skills = skills;
        }
    }

    // What the business card shows; kept on the copy being edited, so it's saved with the other fields.
    private ProfileVisibility visibility => profileDto!.Visibility ??= new();

    protected override async Task OnInitializedAsync()
    {
        await StateService.InitializeAsync(); // after a page refresh the sign-in is restored from storage
        if (!StateService.IsAuthenticated || StateService.CurrentUser == null)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/profile")}");
            return;
        }

        // Start from the latest saved profile (it may have been changed on another device).
        await PortalAuth.RefreshProfileAsync();

        // Edit a copy: changes reach the signed-in user only once the server has saved them.
        profileDto = Copy(StateService.CurrentUser);
    }

    private static UserProfileDto Copy(UserProfileDto user) =>
        System.Text.Json.JsonSerializer.Deserialize<UserProfileDto>(System.Text.Json.JsonSerializer.Serialize(user))!;

    private async Task SaveProfile()
    {
        if (profileDto == null) return;

        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            // The API updates the signed-in user's own profile (UserController: PUT api/user/profile).
            var response = await ApiService.PutAsync("api/user/profile", new
            {
                profileDto.FirstName,
                profileDto.LastName,
                CompanyName = profileDto.CompanyName ?? "",
                PhoneNumber = profileDto.PhoneNumber ?? "",
                Bio = profileDto.Bio ?? "",
                Skills = profileDto.Skills ?? "",
                profileDto.ServicePricing,
                // The picture is saved by its own upload (ProfilePictureUpload), not with this form.
                Visibility = visibility
            });

            if (response.IsSuccessStatusCode)
            {
                var saved = await ApiService.ParseResponseAsync<UserProfileDto>(response);
                if (saved != null && StateService.CurrentUser != null)
                {
                    // Take the saved profile fields; keep what the response doesn't carry (e.g. the role).
                    var user = Copy(StateService.CurrentUser);
                    user.FirstName = saved.FirstName;
                    user.LastName = saved.LastName;
                    user.CompanyName = saved.CompanyName;
                    user.PhoneNumber = saved.PhoneNumber;
                    user.Bio = saved.Bio;
                    user.Skills = saved.Skills;
                    user.ServicePricing = saved.ServicePricing;
                    user.ProfileImageUrl = saved.ProfileImageUrl;
                    user.Visibility = saved.Visibility ?? visibility;
                    StateService.CurrentUser = user;
                    profileDto = Copy(user);
                }
                successMessage = "Profile updated successfully!";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Your session has expired. Log in again, then save your changes.";
            }
            else
            {
                errorMessage = await ApiService.ReadErrorAsync(response, "Failed to update profile. Please try again.");
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            errorMessage = PortalAuthService.ConnectionProblem;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/dashboard");
    }
}

<style>
    /* Field label on the left, "Show on my card" on the right */
    .profile-label-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .profile-label-row .show-on-card {
        white-space: nowrap;
    }

    /* The Skills box opens a picker; show it as clickable rather than greyed out */
    .skills-input[readonly] {
        background-color: var(--bs-body-bg);
        cursor: pointer;
    }

    .profile-label-row .show-on-card .form-check-label {
        color: var(--bs-secondary-color);
    }
</style>
