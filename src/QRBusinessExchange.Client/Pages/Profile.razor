@page "/profile"
@using QRBusinessExchange.Core.DTOs
@using QRBusinessExchange.Client.Services
@inject ApiService ApiService
@inject StateService StateService
@inject PortalAuthService PortalAuth
@inject NavigationManager Navigation

<PageTitle>Edit Profile - qrbound</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="mb-4">Edit Profile</h3>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            @successMessage
                        </div>
                    }

                    @if (profileDto != null)
                    {
                        <EditForm Model="profileDto" OnValidSubmit="SaveProfile" FormName="profileForm">
                            <DataAnnotationsValidator />
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="firstName" class="form-label">First Name</label>
                                    <InputText id="firstName" @bind-Value="profileDto.FirstName" class="form-control" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="lastName" class="form-label">Last Name</label>
                                    <InputText id="lastName" @bind-Value="profileDto.LastName" class="form-control" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <InputText id="email" @bind-Value="profileDto.Email" class="form-control" disabled />
                            </div>

                            <div class="mb-3">
                                <label for="companyName" class="form-label">Company Name</label>
                                <InputText id="companyName" @bind-Value="profileDto.CompanyName" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label for="phoneNumber" class="form-label">Phone Number</label>
                                <InputText id="phoneNumber" @bind-Value="profileDto.PhoneNumber" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label for="bio" class="form-label">Bio</label>
                                <InputTextArea id="bio" @bind-Value="profileDto.Bio" class="form-control" rows="4" />
                            </div>

                            <div class="mb-3">
                                <label for="skills" class="form-label">Skills (comma-separated)</label>
                                <InputText id="skills" @bind-Value="profileDto.Skills" class="form-control" 
                                          placeholder="e.g., Web Development, Marketing, Design" />
                            </div>

                            <div class="mb-3">
                                <label for="servicePricing" class="form-label">Service Pricing ($)</label>
                                <InputNumber id="servicePricing" @bind-Value="profileDto.ServicePricing" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label for="profileImage" class="form-label">Profile Image URL</label>
                                <InputText id="profileImage" @bind-Value="profileDto.ProfileImageUrl" class="form-control" />
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>Save Changes</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private UserProfileDto? profileDto;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await StateService.InitializeAsync(); // after a page refresh the sign-in is restored from storage
        if (!StateService.IsAuthenticated || StateService.CurrentUser == null)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/profile")}");
            return;
        }

        // Start from the latest saved profile (it may have been changed on another device).
        await PortalAuth.RefreshProfileAsync();

        // Edit a copy: changes reach the signed-in user only once the server has saved them.
        profileDto = Copy(StateService.CurrentUser);
    }

    private static UserProfileDto Copy(UserProfileDto user) =>
        System.Text.Json.JsonSerializer.Deserialize<UserProfileDto>(System.Text.Json.JsonSerializer.Serialize(user))!;

    private async Task SaveProfile()
    {
        if (profileDto == null) return;

        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            // The API updates the signed-in user's own profile (UserController: PUT api/user/profile).
            var response = await ApiService.PutAsync("api/user/profile", new
            {
                profileDto.FirstName,
                profileDto.LastName,
                CompanyName = profileDto.CompanyName ?? "",
                PhoneNumber = profileDto.PhoneNumber ?? "",
                Bio = profileDto.Bio ?? "",
                Skills = profileDto.Skills ?? "",
                profileDto.ServicePricing,
                ProfileImageUrl = profileDto.ProfileImageUrl ?? ""
            });

            if (response.IsSuccessStatusCode)
            {
                var saved = await ApiService.ParseResponseAsync<UserProfileDto>(response);
                if (saved != null && StateService.CurrentUser != null)
                {
                    // Take the saved profile fields; keep what the response doesn't carry (e.g. the role).
                    var user = Copy(StateService.CurrentUser);
                    user.FirstName = saved.FirstName;
                    user.LastName = saved.LastName;
                    user.CompanyName = saved.CompanyName;
                    user.PhoneNumber = saved.PhoneNumber;
                    user.Bio = saved.Bio;
                    user.Skills = saved.Skills;
                    user.ServicePricing = saved.ServicePricing;
                    user.ProfileImageUrl = saved.ProfileImageUrl;
                    StateService.CurrentUser = user;
                    profileDto = Copy(user);
                }
                successMessage = "Profile updated successfully!";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Your session has expired. Log in again, then save your changes.";
            }
            else
            {
                errorMessage = await ApiService.ReadErrorAsync(response, "Failed to update profile. Please try again.");
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            errorMessage = PortalAuthService.ConnectionProblem;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/dashboard");
    }
}
