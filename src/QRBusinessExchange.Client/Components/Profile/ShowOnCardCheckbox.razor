@* "Show on my card" checkbox placed next to a profile field's label. *@

<div class="form-check show-on-card mb-0">
    <input class="form-check-input" type="checkbox" id="@Id" checked="@Value"
           @onchange="OnChangedAsync" />
    <label class="form-check-label small" for="@Id" title="@Title">Show on my card</label>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Which field this controls, for the tooltip (e.g. "your phone number").</summary>
    [Parameter] public string Field { get; set; } = "this";

    private string Title => Value
            ? $"People who open your business card, and your contacts, can see {Field}"
            : $"Only you can see {Field}";

    private Task OnChangedAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is true);
}
