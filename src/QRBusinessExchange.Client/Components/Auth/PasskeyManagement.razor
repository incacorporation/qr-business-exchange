@using QRBusinessExchange.Client.Services
@using QRBusinessExchange.Core.DTOs
@inject WebAuthnService WebAuthnService
@inject ApiService ApiService
@inject StateService StateService
@inject IJSRuntime JSRuntime

<div class="passkey-management">
    <h5 class="mb-3">
        <i class="bi bi-fingerprint me-2"></i>Passkey Management
    </h5>

    @if (!isSupported || !isPlatformAuthAvailable)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Passkeys are not available on this device or browser.
        </div>
    }
    else
    {
        <p class="text-muted small mb-3">
            Passkeys provide a secure, passwordless way to sign in using biometrics, PIN, or security key.
        </p>

        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <!-- Registered Passkeys List -->
            @if (passkeys.Any())
            {
                <div class="list-group mb-3">
                    @foreach (var passkey in passkeys)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">
                                        <i class="bi bi-key me-2"></i>@passkey.DeviceName
                                    </h6>
                                    <small class="text-muted">
                                        Created: @passkey.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                        @if (passkey.LastUsed.HasValue)
                                        {
                                            <span class="ms-2">
                                                | Last used: @passkey.LastUsed.Value.ToLocalTime().ToString("MMM dd, yyyy")
                                            </span>
                                        }
                                    </small>
                                </div>
                                <button class="btn btn-sm btn-outline-danger" 
                                        @onclick="() => DeletePasskey(passkey.CredentialId)"
                                        disabled="@isDeleting">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    You don't have any passkeys registered yet.
                </div>
            }

            <!-- Add Passkey Button -->
            <button class="btn btn-primary" 
                    @onclick="RegisterPasskey"
                    disabled="@isRegistering">
                @if (isRegistering)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Registering...</span>
                }
                else
                {
                    <i class="bi bi-plus-circle me-2"></i>
                    <span>Add Passkey</span>
                }
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success mt-3" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@successMessage
                </div>
            }
        }
    }
</div>

@code {
    private bool isSupported = false;
    private bool isPlatformAuthAvailable = false;
    private bool isLoading = true;
    private bool isRegistering = false;
    private bool isDeleting = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private List<PasskeyInfoDto> passkeys = new();

    protected override async Task OnInitializedAsync()
    {
        await CheckPasskeySupport();
        await LoadPasskeys();
    }

    private async Task CheckPasskeySupport()
    {
        try
        {
            isSupported = await WebAuthnService.IsSupportedAsync();
            if (isSupported)
            {
                isPlatformAuthAvailable = await WebAuthnService.IsPlatformAuthenticatorAvailableAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking passkey support: {ex.Message}");
        }
    }

    /// <summary>Reloads the list (e.g. after a phone was linked from another component).</summary>
    public async Task ReloadAsync()
    {
        await LoadPasskeys();
        StateHasChanged();
    }

    private async Task LoadPasskeys()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await ApiService.GetAsync<PasskeyListDto>("api/passkey/list");
            if (response != null)
            {
                passkeys = response.Passkeys;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading passkeys: {ex.Message}");
            errorMessage = "Failed to load passkeys";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RegisterPasskey()
    {
        if (StateService.CurrentUser == null)
        {
            errorMessage = "User not logged in";
            return;
        }

        isRegistering = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            // Step 1: Get registration options from server
            var deviceName = await GetDeviceName();
            var initRequest = new PasskeyRegistrationInitRequest
            {
                Email = StateService.CurrentUser.Email,
                DeviceName = deviceName
            };

            var response = await ApiService.PostAsync("api/passkey/register/init", initRequest);

            if (!response.IsSuccessStatusCode)
            {
                throw new Exception("Failed to initiate passkey registration");
            }

            var options = await ApiService.ParseResponseAsync<PasskeyRegistrationOptionsDto>(response);

            if (options == null)
            {
                throw new Exception("Invalid registration options");
            }

            // Step 2: Create credential with passkey
            var credential = await WebAuthnService.RegisterPasskeyAsync(options);

            if (credential == null)
            {
                throw new Exception("Passkey registration was cancelled or failed");
            }

            // Step 3: Complete registration on server
            var completeRequest = new PasskeyRegistrationCompleteRequest
            {
                Email = StateService.CurrentUser.Email,
                Challenge = options.Challenge,
                Credential = new CredentialResponseDto
                {
                    Id = credential.Id,
                    RawId = credential.RawId,
                    Type = credential.Type,
                    Response = new AttestationResponseDto
                    {
                        ClientDataJSON = credential.Response.ClientDataJSON,
                        AttestationObject = credential.Response.AttestationObject
                    },
                    Transports = credential.Transports?.ToList()
                },
                DeviceName = deviceName
            };

            var completeResponse = await ApiService.PostAsync("api/passkey/register/complete", completeRequest);

            if (!completeResponse.IsSuccessStatusCode)
            {
                var error = await completeResponse.Content.ReadAsStringAsync();
                throw new Exception($"Registration failed: {error}");
            }

            successMessage = "Passkey registered successfully!";
            await LoadPasskeys();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Passkey registration error: {ex.Message}");
            errorMessage = ex.Message.Contains("cancelled") || ex.Message.Contains("aborted")
                ? "Passkey registration was cancelled"
                : "Failed to register passkey. Please try again.";
        }
        finally
        {
            isRegistering = false;
            StateHasChanged();
        }
    }

    private async Task DeletePasskey(string credentialId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this passkey?"))
        {
            return;
        }

        isDeleting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            var response = await ApiService.DeleteAsync($"api/passkey/{Uri.EscapeDataString(credentialId)}");

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Passkey deleted successfully";
                await LoadPasskeys();
            }
            else
            {
                throw new Exception("Failed to delete passkey");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting passkey: {ex.Message}");
            errorMessage = "Failed to delete passkey";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private async Task<string> GetDeviceName()
    {
        try
        {
            var userAgent = await JSRuntime.InvokeAsync<string>("eval", "navigator.userAgent");
            
            if (userAgent.Contains("Windows"))
                return "Windows PC";
            else if (userAgent.Contains("Mac"))
                return "Mac";
            else if (userAgent.Contains("iPhone"))
                return "iPhone";
            else if (userAgent.Contains("iPad"))
                return "iPad";
            else if (userAgent.Contains("Android"))
                return "Android Device";
            else
                return "Unknown Device";
        }
        catch
        {
            return "Unknown Device";
        }
    }
}

<style>
    .passkey-management .list-group-item {
        border-left: 4px solid var(--bs-primary);
    }

    .passkey-management .list-group-item:hover {
        background-color: var(--bs-light);
    }
</style>
