@* The text-message consent wording, the same on the sign-up page and in Settings. *@
<strong class="sms-consent-lead">Yes, I agree to receive text messages from qrbound at @NumberText.</strong>
<span class="sms-consent-details">
    <span><strong>What you'll get:</strong> account and security alerts only, such as sign-in alerts and verification codes. No marketing.</span>
    <span><strong>How often:</strong> message frequency varies with your account activity.</span>
    <span>Message and data rates may apply.</span>
    <span>Reply <strong>HELP</strong> for help. Reply <strong>STOP</strong> to opt out at any time.</span>
    <span>Optional: you don't need to agree to create an account.</span>
    <span>See our <a href="/terms#sms" target="_blank">Terms of Service</a> and <a href="/privacy#sms" target="_blank">Privacy Policy</a>.</span>
</span>

@code {
    /// <summary>Where the texts go, e.g. "the number above" or the number itself.</summary>
    [Parameter] public string NumberText { get; set; } = "the number above";
}
