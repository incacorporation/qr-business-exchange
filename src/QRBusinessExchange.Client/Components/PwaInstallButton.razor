@* "Install app" call to action.
   Variant="Floating": fixed bottom-left button, shown on desktop (>= 992px) only, can be dismissed for the session.
   Variant="Footer":   static footer link, shown on mobile/tablet (< 992px) only.
   Appears only when the browser can install the PWA (beforeinstallprompt) or on iPhone/iPad, where it
   explains Share > Add to Home Screen instead. Hidden once the app is installed. *@
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsVisible)
{
    if (Variant == InstallButtonVariant.Floating)
    {
        <div class="pwa-install-floating d-none d-lg-flex" role="region" aria-label="Install app">
            <button type="button" class="pwa-install-floating-btn" @onclick="InstallAsync">
                <span class="pwa-install-icon"><img src="images/qrbound-mark.svg" alt="" /></span>
                <span class="pwa-install-text">
                    <span class="pwa-install-title">Install app</span>
                    <span class="pwa-install-sub">Fast access from your desktop</span>
                </span>
                <i class="bi bi-download pwa-install-arrow"></i>
            </button>
            <button type="button" class="pwa-install-close" aria-label="Hide install button" @onclick="DismissAsync">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }
    else
    {
        <button type="button" class="pwa-install-footer d-lg-none" @onclick="InstallAsync">
            <i class="bi bi-phone"></i> Install app
        </button>
    }

    @if (showIosHelp)
    {
        <div class="pwa-ios-help-backdrop" @onclick="() => showIosHelp = false"></div>
        <div class="pwa-ios-help" role="dialog" aria-modal="true" aria-labelledby="pwa-ios-help-title">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
                <h3 id="pwa-ios-help-title">Add qrbound to your Home Screen</h3>
                <button type="button" class="btn-close" aria-label="Close" @onclick="() => showIosHelp = false"></button>
            </div>
            <ol>
                <li>Tap the <strong>Share</strong> button <i class="bi bi-box-arrow-up"></i> in Safari.</li>
                <li>Choose <strong>Add to Home Screen</strong> <i class="bi bi-plus-square"></i>.</li>
                <li>Tap <strong>Add</strong>.</li>
            </ol>
        </div>
    }
}

@code {
    public enum InstallButtonVariant { Floating, Footer }

    [Parameter] public InstallButtonVariant Variant { get; set; } = InstallButtonVariant.Floating;

    private const string DismissKey = "pwaInstallDismissed";

    private InstallState state = new();
    private bool dismissed;
    private bool showIosHelp;
    private DotNetObjectReference<PwaInstallButton>? selfRef;

    private bool IsVisible =>
        !state.Installed
        && (state.CanPrompt || state.IsIos)
        && !(Variant == InstallButtonVariant.Floating && dismissed);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            selfRef = DotNetObjectReference.Create(this);
            state = await JS.InvokeAsync<InstallState>("pwaService.subscribeInstallState", selfRef);

            if (Variant == InstallButtonVariant.Floating)
            {
                dismissed = await JS.InvokeAsync<string?>("sessionStorage.getItem", DismissKey) == "1";
            }

            StateHasChanged();
        }
        catch (JSException ex)
        {
            Console.WriteLine($"PwaInstallButton: install state unavailable: {ex.Message}");
        }
    }

    [JSInvokable]
    public Task OnInstallStateChanged(InstallState newState)
    {
        state = newState;
        return InvokeAsync(StateHasChanged);
    }

    private async Task InstallAsync()
    {
        if (state.CanPrompt)
        {
            await JS.InvokeAsync<string>("pwaService.showInstallPrompt");
        }
        else if (state.IsIos)
        {
            showIosHelp = true;
        }
    }

    private async Task DismissAsync()
    {
        dismissed = true;
        await JS.InvokeVoidAsync("sessionStorage.setItem", DismissKey, "1");
    }

    public async ValueTask DisposeAsync()
    {
        if (selfRef is null) return;

        try
        {
            await JS.InvokeVoidAsync("pwaService.unsubscribeInstallState", selfRef);
        }
        catch (JSDisconnectedException)
        {
        }

        selfRef.Dispose();
    }

    public sealed class InstallState
    {
        public bool Installed { get; set; }
        public bool CanPrompt { get; set; }
        public bool IsIos { get; set; }
    }
}
