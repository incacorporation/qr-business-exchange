@using QRBusinessExchange.Client.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@MapId" style="height: @Height; width: 100%; border-radius: 15px;"></div>

@code {
    [Parameter]
    public List<UserLocationDto>? Users { get; set; }

    [Parameter]
    public Guid? CurrentUserId { get; set; }

    [Parameter]
    public string Height { get; set; } = "500px";

    [Parameter]
    public double DefaultLat { get; set; } = 40.7128;

    [Parameter]
    public double DefaultLng { get; set; } = -74.0060;

    [Parameter]
    public int DefaultZoom { get; set; } = 12;

    private string MapId = $"map-{Guid.NewGuid():N}";
    private bool _isInitialized = false;
    private bool _disposed = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            await InitializeMapAsync();
        }
    }

    private async Task InitializeMapAsync()
    {
        if (_isInitialized || _disposed)
            return;

        try
        {
            // Wait for DOM and Leaflet to be ready
            await Task.Delay(500);

            if (_disposed) return;

            // Check if Leaflet is loaded
            var leafletLoaded = await JS.InvokeAsync<bool>("eval", "typeof L !== 'undefined'");
            if (!leafletLoaded)
            {
                Console.WriteLine("Leaflet library not loaded yet, waiting...");
                await Task.Delay(1000);
                leafletLoaded = await JS.InvokeAsync<bool>("eval", "typeof L !== 'undefined'");
                if (!leafletLoaded)
                {
                    Console.WriteLine("ERROR: Leaflet library failed to load");
                    return;
                }
            }

            Console.WriteLine($"Initializing map with MapId: {MapId}");
            Console.WriteLine($"Users count: {Users?.Count ?? 0}");

            // Determine center coordinates
            double lat = DefaultLat;
            double lng = DefaultLng;
            int zoom = DefaultZoom;

            if (Users != null && Users.Any())
            {
                var firstUser = Users.First();
                lat = firstUser.Latitude;
                lng = firstUser.Longitude;
                Console.WriteLine($"Using first user location: {lat}, {lng}");
            }
            else
            {
                Console.WriteLine($"No users, using default location: {lat}, {lng}");
            }

            // Initialize map
            await JS.InvokeVoidAsync("leafletInterop.initializeMap", MapId, lat, lng, zoom);
            _isInitialized = true;
            Console.WriteLine("Map initialized successfully");

            if (_disposed) return;

            // Add markers for users
            if (Users != null && Users.Any())
            {
                Console.WriteLine($"Adding {Users.Count} markers...");
                foreach (var user in Users)
                {
                    if (_disposed) break;

                    var companyLine = string.IsNullOrEmpty(user.CompanyName) 
                        ? "" 
                        : $"<p class='mb-1 text-muted'><i class='fas fa-building'></i> {user.CompanyName}</p>";
                    
                    var popupContent = $@"
                        <div class='text-center p-2'>
                            <h6 class='mb-2'><i class='fas fa-user'></i> {user.FirstName} {user.LastName}</h6>
                            {companyLine}
                            <a href='/profile/{user.UserId}' class='btn btn-sm btn-primary mt-2'>
                                <i class='fas fa-eye'></i> View Profile
                            </a>
                        </div>";

                    await JS.InvokeVoidAsync("leafletInterop.addMarker", 
                        user.Latitude, 
                        user.Longitude, 
                        popupContent,
                        user.UserId == CurrentUserId);
                    
                    Console.WriteLine($"Added marker for {user.FirstName} {user.LastName}");
                }
                Console.WriteLine("All markers added successfully");
            }
        }
        catch (JSDisconnectedException)
        {
            Console.WriteLine("ERROR: Circuit disconnected while initializing map");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR initializing map: {ex.GetType().Name} - {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }

    public async Task RefreshMarkers(List<UserLocationDto> newUsers)
    {
        if (!_isInitialized || _disposed)
            return;

        try
        {
            // Clear existing markers
            await JS.InvokeVoidAsync("leafletInterop.clearMarkers");

            Users = newUsers;

            // Add new markers
            if (Users != null && Users.Any())
            {
                foreach (var user in Users)
                {
                    if (_disposed) break;

                    var companyLine = string.IsNullOrEmpty(user.CompanyName) 
                        ? "" 
                        : $"<p class='mb-1'>{user.CompanyName}</p>";
                    
                    var popupContent = $@"
                        <div class='text-center'>
                            <h6>{user.FirstName} {user.LastName}</h6>
                            {companyLine}
                            <a href='/profile/{user.UserId}' class='btn btn-sm btn-primary'>View Profile</a>
                        </div>";

                    await JS.InvokeVoidAsync("leafletInterop.addMarker", 
                        user.Latitude, 
                        user.Longitude, 
                        popupContent,
                        user.UserId == CurrentUserId);
                }
            }
        }
        catch (JSDisconnectedException)
        {
            Console.WriteLine("Circuit disconnected while refreshing markers");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing markers: {ex.Message}");
        }
    }

    public async Task SetViewAsync(double lat, double lng, int zoom)
    {
        if (!_isInitialized || _disposed)
            return;

        try
        {
            await JS.InvokeVoidAsync("leafletInterop.setView", lat, lng, zoom);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting map view: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;

        _disposed = true;

        try
        {
            if (_isInitialized)
            {
                await JS.InvokeVoidAsync("leafletInterop.destroyMap");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error disposing map: {ex.Message}");
        }
    }
}

