@using Microsoft.JSInterop
@inherits LayoutComponentBase
@inject StateService StateService
@inject NavigationManager Navigation
@inject PortalAuthService PortalAuth
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="page @(navOpen ? "nav-open" : "") @(StateService.IsAuthenticated ? "has-bottom-nav" : "")">

    <!-- Mobile / tablet app bar (hidden on large screens, where the sidebar is always visible) -->
    <header class="app-bar d-lg-none">
        <button type="button" class="app-bar-btn" aria-label="Open menu" aria-controls="app-sidebar"
                aria-expanded="@(navOpen ? "true" : "false")" @onclick="ToggleNav">
            <i class="bi bi-list"></i>
        </button>
        <a class="brand-lockup" href="" aria-label="qrbound home">
            <img src="images/qrbound-mark.svg" class="brand-mark" alt="" />
            <span class="brand-wordmark">qrbound</span>
        </a>
        <div class="app-bar-actions">
            @if (StateService.IsAuthenticated)
            {
                <a href="/profile" class="app-bar-btn" aria-label="Your profile">
                    <UserAvatar Size="1.75rem" />
                </a>
            }
            else
            {
                <a href="/login" class="btn btn-sm btn-light app-bar-login">Login</a>
            }
        </div>
    </header>

    <!-- Tap outside the drawer to close it -->
    <div class="nav-backdrop d-lg-none" @onclick="CloseNav" aria-hidden="true"></div>

    <aside class="sidebar" id="app-sidebar" aria-label="Main navigation">
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid px-0 pe-2">
                <a class="navbar-brand brand-lockup" href="" aria-label="qrbound home">
                    <img src="images/qrbound-mark.svg" class="brand-mark" alt="" />
                    <span class="brand-wordmark">qrbound</span>
                </a>
                <button type="button" class="app-bar-btn d-lg-none" aria-label="Close menu" @onclick="CloseNav">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        @if (StateService.IsAuthenticated)
        {
            <!-- Who is signed in (on large screens this lives in the top bar instead) -->
            <div class="sidebar-user d-lg-none">
                <UserAvatar Size="2.25rem" />
                <div class="sidebar-user-text">
                    <div class="fw-semibold text-truncate">@StateService.UserFullName</div>
                    <span class="subscription-badge @(StateService.SubscriptionType == "Free" ? "badge-free" : "badge-paid")">
                        @StateService.SubscriptionType
                    </span>
                </div>
            </div>
        }

        <div class="nav-scrollable">
            <nav class="flex-column">
                <div class="nav-item px-3">
                    <NavLink href="" class="nav-link" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door-fill"></i> Home
                    </NavLink>
                </div>
                @if (StateService.IsAuthenticated)
                {
                    <div class="nav-item px-3">
                        <NavLink href="dashboard" class="nav-link">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink href="business-card" class="nav-link">
                            <i class="bi bi-qr-code"></i> Business Card
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink href="contacts" class="nav-link">
                            <i class="bi bi-person-lines-fill"></i> Contacts
                        </NavLink>
                    </div>
                    @* Phone only: the scanner uses the camera, so it's hidden in the desktop layout. *@
                    <div class="nav-item px-3 d-lg-none">
                        <NavLink href="scan" class="nav-link">
                            <i class="bi bi-qr-code-scan"></i> Scan QR code
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink href="register-device" class="nav-link">
                            <i class="bi bi-fingerprint"></i> Register device
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink href="profile" class="nav-link">
                            <i class="bi bi-person-circle"></i> Profile
                        </NavLink>
                    </div>
                    @* Connections and Analytics links removed until those pages exist (/connections, /analytics). *@
                    <div class="nav-item px-3">
                        <NavLink href="businesses" class="nav-link">
                            <i class="bi bi-buildings"></i> Business Profile
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink href="settings" class="nav-link">
                            <i class="bi bi-gear-fill"></i> Settings
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink href="logout" class="nav-link">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </NavLink>
                    </div>
                }
                else
                {
                    <div class="nav-item px-3">
                        <NavLink href="login" class="nav-link">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink href="register" class="nav-link">
                            <i class="bi bi-person-plus"></i> Register
                        </NavLink>
                    </div>
                }
            </nav>
        </div>
    </aside>

    <main>
        <!-- Desktop top bar -->
        <div class="top-row d-none d-lg-flex">
            @if (StateService.IsAuthenticated)
            {
                <div class="d-flex align-items-center gap-3 min-w-0">
                    <div class="d-flex align-items-center min-w-0">
                        <UserAvatar Size="1.75rem" CssClass="text-primary-custom me-2" />
                        <span class="fw-semibold text-dark-color text-truncate">@StateService.UserFullName</span>
                    </div>
                    <span class="subscription-badge @(StateService.SubscriptionType == "Free" ? "badge-free" : "badge-paid")">
                        @StateService.SubscriptionType
                    </span>
                    <a href="/logout" class="btn btn-sm btn-outline-danger text-nowrap">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex gap-2">
                    <a href="/login" class="btn btn-sm btn-primary">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                    <a href="/register" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-person-plus"></i> Register
                    </a>
                </div>
            }
        </div>

        <article class="content">
            @Body
        </article>
    </main>

    <!-- Desktop only: floating "Install app" (mobile gets a footer link instead) -->
    <PwaInstallButton Variant="PwaInstallButton.InstallButtonVariant.Floating" />

    @if (StateService.IsAuthenticated)
    {
        <!-- Mobile bottom tab bar: one-thumb access to the main sections -->
        <nav class="bottom-nav d-lg-none" aria-label="Quick navigation">
            <NavLink href="" Match="NavLinkMatch.All" class="bottom-nav-item">
                <i class="bi bi-house-door"></i><span>Home</span>
            </NavLink>
            <NavLink href="dashboard" class="bottom-nav-item">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </NavLink>
            <NavLink href="businesses" class="bottom-nav-item">
                <i class="bi bi-buildings"></i><span>Business</span>
            </NavLink>
            <NavLink href="profile" class="bottom-nav-item">
                <i class="bi bi-person"></i><span>Profile</span>
            </NavLink>
            <button type="button" class="bottom-nav-item" aria-controls="app-sidebar"
                    aria-expanded="@(navOpen ? "true" : "false")" @onclick="ToggleNav">
                <i class="bi bi-three-dots"></i><span>More</span>
            </button>
        </nav>
    }
</div>

@code {
    private bool navOpen;
    private DotNetObjectReference<MainLayout>? selfRef;
    private DateTime lastProfileRefresh = DateTime.MinValue;

    protected override async Task OnInitializedAsync()
    {
        await StateService.InitializeAsync();
        StateService.OnStateChanged += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;

        // The stored profile may be out of date (changed on another device): reload it in the background.
        _ = RefreshProfileAsync(force: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("appVisibility.watch", selfRef);
            }
            catch (JSException ex)
            {
                // AppVisibility interop may not be available; silently continue
                // The app will function normally, just without tab visibility monitoring
                System.Diagnostics.Debug.WriteLine($"AppVisibility interop unavailable: {ex.Message}");
            }
        }
    }

    /// <summary>The tab or installed app is in the foreground again.</summary>
    [JSInvokable]
    public Task OnAppVisible() => RefreshProfileAsync(force: false);

    /// <summary>Another tab of this browser saved a newer profile.</summary>
    [JSInvokable]
    public Task OnProfileChangedElsewhere() => RefreshProfileAsync(force: true);

    private async Task RefreshProfileAsync(bool force)
    {
        // Switching tabs often shouldn't mean a request every time.
        if (!force && DateTime.UtcNow - lastProfileRefresh < TimeSpan.FromSeconds(30))
        {
            return;
        }
        lastProfileRefresh = DateTime.UtcNow;
        await PortalAuth.RefreshProfileAsync();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void ToggleNav() => navOpen = !navOpen;

    private void CloseNav() => navOpen = false;

    // Close the drawer after the user picks a destination.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (navOpen)
        {
            navOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        StateService.OnStateChanged -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        try
        {
            await JS.InvokeVoidAsync("appVisibility.unwatch");
        }
        catch (JSDisconnectedException) { }
        selfRef?.Dispose();
    }
}
