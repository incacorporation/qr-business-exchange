  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Qrbound.SignIn\Qrbound.SignIn.csproj" />
    <ProjectReference Include="..\..\src\Qrbound.SignIn.Server\Qrbound.SignIn.Server.csproj" />
  </ItemGroup>

</Project>
