<?xml version="1.0" encoding="utf-8"?>
<!--
  The sample installs Qrbound.Payments from the private incacorporation GitHub Packages feed.
  The feed needs a GitHub token with read:packages. Keep it out of the repository: set the
  environment variable NuGetPackageSourceCredentials_qrbound to "Username=<github-user>;Password=<token>",
  or store the credentials in your user-level NuGet config (see "Installing" in src/Qrbound.Payments/README.md).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="qrbound" value="https://nuget.pkg.github.com/incacorporation/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="qrbound">
      <package pattern="Qrbound.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
